diff --git a/irc/apichannels.go b/irc/apichannels.go
new file mode 100644
index 00000000..45f129ab
--- /dev/null
+++ b/irc/apichannels.go
@@ -0,0 +1,219 @@
+// Copyright (c) 2026 James Trotter
+// released under the MIT license
+
+package irc
+
+import (
+	"net/http"
+	"slices"
+
+	"github.com/ergochat/ergo/irc/modes"
+)
+
+// Channel access and joins driven by an external system (the boson stack's
+// RoleServ): private channels are +i with an account extban (a:<account>)
+// on +I per allowed account, and members are joined to channels by account.
+
+// modesPerLine bounds the mode changes in one announced MODE line.
+const modesPerLine = 4
+
+type apiChannelAccessRequest struct {
+	Channel string `json:"channel"`
+	// InviteOnly sets (true) or clears (false) +i; nil leaves it alone.
+	InviteOnly *bool `json:"inviteOnly"`
+	// RegisteredOnly sets or clears +R the same way.
+	RegisteredOnly *bool `json:"registeredOnly"`
+	// Accounts are the accounts that must have an a:<account> entry on +I.
+	Accounts []string `json:"accounts"`
+	// SetBy is recorded as the entries' creator. Entries with this creator
+	// whose account isn't in Accounts are removed; entries anyone else made
+	// are left alone. Default "API".
+	SetBy string `json:"setBy"`
+}
+
+type apiChannelAccessResponse struct {
+	apiGenericResponse
+	// Exists is false when no such channel exists (nothing was changed).
+	Exists     bool     `json:"exists"`
+	Registered bool     `json:"registered"`
+	Added      []string `json:"added"`
+	Removed    []string `json:"removed"`
+	InviteOnly bool     `json:"inviteOnly"`
+	// RegisteredOnly is whether the channel is now +R.
+	RegisteredOnly bool `json:"registeredOnly"`
+}
+
+// handleChannelAccess syncs a channel's +i and its account invite
+// exceptions. It never creates a channel.
+func (a *ergoAPI) handleChannelAccess(w http.ResponseWriter, r *http.Request) {
+	var request apiChannelAccessRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+	response := apiChannelAccessResponse{Added: []string{}, Removed: []string{}}
+	setBy := request.SetBy
+	if setBy == "" {
+		setBy = "API"
+	}
+	cfSetBy, err := CasefoldName(setBy)
+	if err != nil {
+		response.ErrorCode = "INVALID_SETBY"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	want := make(map[string]bool, len(request.Accounts))
+	for _, account := range request.Accounts {
+		cf, err := CasefoldName(account)
+		if err != nil {
+			continue // can't be anyone's account
+		}
+		want[cf] = true
+	}
+
+	channel := a.server.channels.Get(request.Channel)
+	if channel == nil {
+		response.Success = true
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	response.Success, response.Exists = true, true
+	response.Registered = channel.IsRegistered()
+
+	var applied modes.ModeChanges
+	for mode, on := range map[modes.Mode]*bool{modes.InviteOnly: request.InviteOnly, modes.RegisteredOnly: request.RegisteredOnly} {
+		if on != nil && channel.flags.SetMode(mode, *on) {
+			op := modes.Remove
+			if *on {
+				op = modes.Add
+			}
+			applied = append(applied, modes.ModeChange{Mode: mode, Op: op})
+		}
+	}
+	slices.SortFunc(applied, func(a, b modes.ModeChange) int { return int(a.Mode) - int(b.Mode) })
+	list := channel.lists[modes.InviteMask]
+	have := map[string]bool{}
+	for mask, info := range list.Masks() {
+		account, ok := cutAccountExtban(mask)
+		if !ok {
+			continue
+		}
+		have[account] = true
+		if !want[account] && info.CreatorAccount == cfSetBy {
+			if removed, _ := list.Remove(mask); removed != "" {
+				response.Removed = append(response.Removed, account)
+				applied = append(applied, modes.ModeChange{Mode: modes.InviteMask, Op: modes.Remove, Arg: removed})
+			}
+		}
+	}
+	for account := range want {
+		if have[account] {
+			continue
+		}
+		if added, _ := list.Add(AccountExtbanPrefix+account, setBy, cfSetBy); added != "" {
+			response.Added = append(response.Added, account)
+			applied = append(applied, modes.ModeChange{Mode: modes.InviteMask, Op: modes.Add, Arg: added})
+		}
+	}
+	slices.Sort(response.Added)
+	slices.Sort(response.Removed)
+	response.InviteOnly = channel.flags.HasMode(modes.InviteOnly)
+	response.RegisteredOnly = channel.flags.HasMode(modes.RegisteredOnly)
+
+	var dirty uint
+	for _, change := range applied {
+		if change.Mode == modes.InviteMask {
+			dirty |= IncludeLists
+		} else {
+			dirty |= IncludeModes
+		}
+	}
+	if dirty != 0 {
+		channel.MarkDirty(dirty)
+		channel.announceServerModes(applied)
+	}
+	a.writeJSONResponse(response, w, r)
+}
+
+func cutAccountExtban(mask string) (account string, ok bool) {
+	if len(mask) > len(AccountExtbanPrefix) && mask[:len(AccountExtbanPrefix)] == AccountExtbanPrefix {
+		return mask[len(AccountExtbanPrefix):], true
+	}
+	return "", false
+}
+
+// announceServerModes tells the channel's members about mode changes made
+// by the server (no client source), a few changes per line.
+func (channel *Channel) announceServerModes(applied modes.ModeChanges) {
+	server := channel.server
+	name := channel.Name()
+	members := channel.Members()
+	for len(applied) > 0 {
+		n := min(len(applied), modesPerLine)
+		args := append([]string{name}, applied[:n].Strings()...)
+		applied = applied[n:]
+		for _, member := range members {
+			for _, session := range member.Sessions() {
+				session.Send(nil, server.name, "MODE", args...)
+			}
+		}
+	}
+}
+
+type apiSajoinRequest struct {
+	AccountName string   `json:"accountName"`
+	Channels    []string `json:"channels"`
+}
+
+type apiSajoinResponse struct {
+	apiGenericResponse
+	// Clients is how many connected clients of the account there are (an
+	// always-on client nobody is attached to doesn't count).
+	Clients int `json:"clients"`
+	// Joined are the channels every connected client is now in.
+	Joined []string `json:"joined"`
+	// Failed maps channels that couldn't be joined to the reason.
+	Failed map[string]string `json:"failed"`
+}
+
+// handleSajoin joins every connected client of an account to channels, as
+// SAJOIN does (no +i/+k/+l/ban checks; a missing channel is created).
+func (a *ergoAPI) handleSajoin(w http.ResponseWriter, r *http.Request) {
+	var request apiSajoinRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+	response := apiSajoinResponse{Joined: []string{}, Failed: map[string]string{}}
+	if _, err := CasefoldName(request.AccountName); err != nil {
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	var targets []*Client
+	for _, client := range a.server.accounts.AccountToClients(request.AccountName) {
+		if len(client.Sessions()) > 0 {
+			targets = append(targets, client)
+		}
+	}
+	response.Success = true
+	response.Clients = len(targets)
+	if len(targets) == 0 {
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	for _, chname := range request.Channels {
+		ok := true
+		for _, client := range targets {
+			rb := NewResponseBuffer(client.Sessions()[0])
+			err, _ := a.server.channels.Join(client, chname, "", true, rb)
+			rb.Send(true)
+			if err != nil {
+				ok = false
+				response.Failed[chname] = err.Error()
+			}
+		}
+		if ok {
+			response.Joined = append(response.Joined, chname)
+		}
+	}
+	a.writeJSONResponse(response, w, r)
+}
diff --git a/irc/apichannels_test.go b/irc/apichannels_test.go
new file mode 100644
index 00000000..8151f752
--- /dev/null
+++ b/irc/apichannels_test.go
@@ -0,0 +1,119 @@
+// Copyright (c) 2026 James Trotter
+// released under the MIT license
+
+package irc
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"testing"
+
+	"github.com/ergochat/ergo/irc/modes"
+)
+
+func apiCall(t *testing.T, server *Server, path string, body any, out any) {
+	t.Helper()
+	b, _ := json.Marshal(body)
+	req := httptest.NewRequest(http.MethodPost, path, bytes.NewReader(b))
+	w := httptest.NewRecorder()
+	newAPIHandler(server).(*ergoAPI).mux.ServeHTTP(w, req)
+	if w.Code != http.StatusOK {
+		t.Fatalf("%s: HTTP %d %s", path, w.Code, w.Body.String())
+	}
+	if err := json.Unmarshal(w.Body.Bytes(), out); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func emptyTestChannel(server *Server, name string) *Channel {
+	channel := NewChannel(server, name, name, false, RegisteredChannel{})
+	server.channels.Lock()
+	server.channels.chans[name] = &channelManagerEntry{channel: channel}
+	server.channels.Unlock()
+	return channel
+}
+
+func TestAPIChannelAccess(t *testing.T) {
+	server := channelExpiryTestServer(t, 0)
+	yes, no := true, false
+
+	var resp apiChannelAccessResponse
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#nope", InviteOnly: &yes, Accounts: []string{"alice"}}, &resp)
+	if !resp.Success || resp.Exists {
+		t.Fatalf("missing channel: %+v", resp)
+	}
+	if server.channels.Get("#nope") != nil {
+		t.Fatalf("channel_access must not create channels")
+	}
+
+	channel := emptyTestChannel(server, "#staff")
+	// an entry a channel op made by hand is never touched
+	channel.lists[modes.InviteMask].Add("a:zed", "op!o@h", "op")
+	channel.lists[modes.InviteMask].Add("friend!*@*", "op!o@h", "op")
+
+	resp = apiChannelAccessResponse{}
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#STAFF", InviteOnly: &yes, Accounts: []string{"Alice", "bob", "bad name"}, SetBy: "RoleServ"}, &resp)
+	if !resp.Success || !resp.Exists || resp.Registered || !resp.InviteOnly {
+		t.Fatalf("unexpected response %+v", resp)
+	}
+	if !slices.Equal(resp.Added, []string{"alice", "bob"}) || len(resp.Removed) != 0 {
+		t.Fatalf("added %v removed %v", resp.Added, resp.Removed)
+	}
+	if !channel.flags.HasMode(modes.InviteOnly) || !channel.lists[modes.InviteMask].MatchAccount("bob") {
+		t.Fatalf("modes not applied")
+	}
+	if info := channel.lists[modes.InviteMask].Masks()["a:alice"]; info.CreatorNickmask != "RoleServ" || info.CreatorAccount != "roleserv" {
+		t.Fatalf("creator not recorded: %+v", info)
+	}
+
+	// idempotent
+	resp = apiChannelAccessResponse{}
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#staff", InviteOnly: &yes, Accounts: []string{"alice", "bob"}, SetBy: "RoleServ"}, &resp)
+	if len(resp.Added)+len(resp.Removed) != 0 {
+		t.Fatalf("second sync changed things: %+v", resp)
+	}
+
+	// revoke bob, and alice is not listed by zed's op entry: only RoleServ's go
+	resp = apiChannelAccessResponse{}
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#staff", Accounts: []string{"alice"}, SetBy: "RoleServ"}, &resp)
+	if !slices.Equal(resp.Removed, []string{"bob"}) || channel.lists[modes.InviteMask].MatchAccount("bob") {
+		t.Fatalf("bob not revoked: %+v", resp)
+	}
+	if !channel.lists[modes.InviteMask].MatchAccount("zed") || !channel.lists[modes.InviteMask].Match("friend!x@y") {
+		t.Fatalf("hand-made entries were removed")
+	}
+	if !channel.flags.HasMode(modes.InviteOnly) {
+		t.Fatalf("nil inviteOnly must leave +i alone")
+	}
+
+	// public again
+	resp = apiChannelAccessResponse{}
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#staff", InviteOnly: &no, SetBy: "RoleServ"}, &resp)
+	if resp.InviteOnly || channel.flags.HasMode(modes.InviteOnly) || !slices.Equal(resp.Removed, []string{"alice"}) {
+		t.Fatalf("not made public: %+v", resp)
+	}
+
+	// registered users only
+	resp = apiChannelAccessResponse{}
+	apiCall(t, server, "/v1/channel_access", apiChannelAccessRequest{Channel: "#staff", RegisteredOnly: &yes, SetBy: "RoleServ"}, &resp)
+	if !resp.RegisteredOnly || !channel.flags.HasMode(modes.RegisteredOnly) || resp.InviteOnly {
+		t.Fatalf("+R not set: %+v", resp)
+	}
+}
+
+func TestAPISajoinOffline(t *testing.T) {
+	server := channelExpiryTestServer(t, 0)
+	var resp apiSajoinResponse
+	apiCall(t, server, "/v1/sajoin", apiSajoinRequest{AccountName: "alice", Channels: []string{"#a"}}, &resp)
+	if !resp.Success || resp.Clients != 0 || len(resp.Joined) != 0 {
+		t.Fatalf("offline account: %+v", resp)
+	}
+	resp = apiSajoinResponse{}
+	apiCall(t, server, "/v1/sajoin", apiSajoinRequest{AccountName: "bad name", Channels: []string{"#a"}}, &resp)
+	if resp.Success || resp.ErrorCode != "ACCOUNT_DOES_NOT_EXIST" {
+		t.Fatalf("bad account: %+v", resp)
+	}
+}
