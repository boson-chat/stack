diff --git a/irc/usermaskset.go b/irc/usermaskset.go
index b4e551f3..87c22cb5 100644
--- a/irc/usermaskset.go
+++ b/irc/usermaskset.go
@@ -28,6 +28,27 @@ type UserMaskSet struct {
 	masks                  map[string]MaskInfo
 	regexp                 atomic.Pointer[regexp.Regexp]
 	muteRegexp             atomic.Pointer[regexp.Regexp]
+	// accounts are the casefolded names of the account extbans (a:name)
+	accounts atomic.Pointer[map[string]struct{}]
+}
+
+// AccountExtbanPrefix marks an account extban: a:<account> matches clients
+// logged into that account, whatever their nick or host.
+const AccountExtbanPrefix = "a:"
+
+// canonicalizeListMask canonicalizes a +b/+e/+I mask: an account extban
+// becomes a:<casefolded account> (no wildcards), anything else goes through
+// CanonicalizeMaskWildcard.
+func canonicalizeListMask(mask string) (string, error) {
+	mask = strings.TrimSpace(mask)
+	if len(mask) > len(AccountExtbanPrefix) && strings.EqualFold(mask[:len(AccountExtbanPrefix)], AccountExtbanPrefix) {
+		cfaccount, err := CasefoldName(mask[len(AccountExtbanPrefix):])
+		if err != nil {
+			return "", errInvalidCharacter
+		}
+		return AccountExtbanPrefix + cfaccount, nil
+	}
+	return CanonicalizeMaskWildcard(mask)
 }
 
 func NewUserMaskSet() *UserMaskSet {
@@ -36,7 +57,7 @@ func NewUserMaskSet() *UserMaskSet {
 
 // Add adds the given mask to this set.
 func (set *UserMaskSet) Add(mask, creatorNickmask, creatorAccount string) (maskAdded string, err error) {
-	casefoldedMask, err := CanonicalizeMaskWildcard(mask)
+	casefoldedMask, err := canonicalizeListMask(mask)
 	if err != nil {
 		return
 	}
@@ -67,7 +88,7 @@ func (set *UserMaskSet) Add(mask, creatorNickmask, creatorAccount string) (maskA
 
 // Remove removes the given mask from this set.
 func (set *UserMaskSet) Remove(mask string) (maskRemoved string, err error) {
-	mask, err = CanonicalizeMaskWildcard(mask)
+	mask, err = canonicalizeListMask(mask)
 	if err != nil {
 		return
 	}
@@ -117,6 +138,36 @@ func (set *UserMaskSet) Match(userhost string) bool {
 	return regexp.MatchString(userhost)
 }
 
+// MatchAccount reports whether an account extban (a:name) matches the
+// casefolded account name ("" never matches).
+func (set *UserMaskSet) MatchAccount(cfaccount string) bool {
+	if cfaccount == "" {
+		return false
+	}
+	accounts := set.accounts.Load()
+	if accounts == nil {
+		return false
+	}
+	_, ok := (*accounts)[cfaccount]
