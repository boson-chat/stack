+func TestUserMaskSetAccountExtban(t *testing.T) {
+	s := NewUserMaskSet()
+	added, err := s.Add("a:Alice", "RoleServ", "roleserv")
+	if err != nil || added != "a:alice" {
+		t.Fatalf("Add(a:Alice) = %q, %v; want a:alice", added, err)
+	}
+	if s.Match("alice!~alice@host") {
+		t.Errorf("an account extban must not match by nick")
+	}
+	if !s.MatchAccount("alice") || !s.MatchClient("guest!~g@host", "alice") {
+		t.Errorf("account extban should match the account")
+	}
+	if s.MatchAccount("bob") || s.MatchAccount("") || s.MatchClient("alice!~alice@host", "") {
+		t.Errorf("account extban matched the wrong client")
+	}
+	if got := s.AccountMasks(); len(got) != 1 || got[0] != "alice" {
+		t.Errorf("AccountMasks() = %v", got)
+	}
+	if again, _ := s.Add("A:ALICE", "", ""); again != "" {
+		t.Errorf("duplicate account extban was added as %q", again)
+	}
+	if removed, _ := s.Remove("a:ALICE"); removed != "a:alice" {
+		t.Errorf("Remove(a:ALICE) = %q", removed)
+	}
+	if s.MatchAccount("alice") {
+		t.Errorf("removed account extban still matches")
+	}
+	// a restored registration (SetMasks) keeps account extbans working
+	s.SetMasks(map[string]MaskInfo{"a:carol": {}, "dave!*@*": {}})
+	if !s.MatchAccount("carol") || !s.Match("dave!~d@h") || s.Match("a:carol!*@*") {
+		t.Errorf("SetMasks lost the account extban split")
+	}
+}
