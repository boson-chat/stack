--- /dev/null
+++ b/irc/apidisconnect.go
@@ -0,0 +1,70 @@
+// Copyright (c) 2026 James Trotter
+// released under the MIT license
+
+package irc
+
+import (
+	"fmt"
+	"net/http"
+
+	"github.com/ergochat/ergo/irc/sno"
+)
+
+// Disconnecting an account's clients from an external account system (the
+// boson stack drops accounts disabled in its auth service, such as a banned
+// federated user): every client logged into the account quits, always-on
+// ones included, and always-on is switched off for the account so that a
+// restart doesn't bring it back. The account, its channels and settings are
+// otherwise kept; refusing new logins is up to the account system.
+
+type apiAccountDisconnectRequest struct {
+	AccountName string `json:"accountName"`
+	// Reason is the QUIT message (default: "You are no longer authorized
+	// to be on this server").
+	Reason string `json:"reason"`
+}
+
+type apiAccountDisconnectResponse struct {
+	apiGenericResponse
+	// Clients: how many clients were disconnected.
+	Clients int `json:"clients"`
+}
+
+func (a *ergoAPI) handleAccountDisconnect(w http.ResponseWriter, r *http.Request) {
+	var request apiAccountDisconnectRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+	var response apiAccountDisconnectResponse
+	cfaccount, err := CasefoldName(request.AccountName)
+	if err != nil {
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	// a copy: quitting clients edit the account's client list
+	clients := append([]*Client(nil), a.server.accounts.AccountToClients(cfaccount)...)
+	if len(clients) > 0 {
+		// (an always-on client is on the list, connected or not)
+		_, _ = a.server.accounts.ModifyAccountSettings(cfaccount, func(s AccountSettings) (AccountSettings, error) {
+			s.AlwaysOn = PersistentDisabled
+			return s, nil
+		})
+	}
+	for _, client := range clients {
+		reason := request.Reason
+		if reason == "" {
+			reason = client.t("You are no longer authorized to be on this server")
+		}
+		client.Logout()
+		client.Quit(reason, nil, nil)
+		client.destroy(nil)
+	}
+	response.Success = true
+	response.Clients = len(clients)
+	if len(clients) > 0 {
+		a.server.logger.Info("api", "disconnected account", request.AccountName, fmt.Sprintf("(%d clients)", len(clients)))
+		a.server.snomasks.Send(sno.LocalAccounts, fmt.Sprintf("API disconnected account %s (%d clients)", request.AccountName, len(clients)))
+	}
+	a.writeJSONResponse(response, w, r)
+}
diff --git a/irc/apidisconnect_test.go b/irc/apidisconnect_test.go
new file mode 100644
index 0000000..ee7137a
--- /dev/null
+++ b/irc/apidisconnect_test.go
@@ -0,0 +1,22 @@
+// Copyright (c) 2026 James Trotter
+// released under the MIT license
+
+package irc
+
+import "testing"
+
+func TestAPIAccountDisconnect(t *testing.T) {
+	server := channelExpiryTestServer(t, 0)
+
+	var resp apiAccountDisconnectResponse
+	apiCall(t, server, "/v1/account_disconnect", apiAccountDisconnectRequest{AccountName: "alice"}, &resp)
+	if !resp.Success || resp.Clients != 0 {
+		t.Fatalf("offline account: %+v", resp)
+	}
+
+	resp = apiAccountDisconnectResponse{}
+	apiCall(t, server, "/v1/account_disconnect", apiAccountDisconnectRequest{AccountName: "bad name"}, &resp)
+	if resp.Success || resp.ErrorCode != "ACCOUNT_DOES_NOT_EXIST" {
+		t.Fatalf("bad account: %+v", resp)
+	}
+}
