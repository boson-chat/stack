+type apiNsUnregisterRequest struct {
+	AccountName string `json:"accountName"`
+	Erase       bool   `json:"erase"`
+}
+
+// handleNsUnregister unregisters (or erases) an account, with the same
+// semantics as NS UNREGISTER / NS ERASE: the account's clients are
+// disconnected and its channels are unregistered.
+func (a *ergoAPI) handleNsUnregister(w http.ResponseWriter, r *http.Request) {
+	var request apiNsUnregisterRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+
+	var response apiGenericResponse
+	_, err := a.server.accounts.LoadAccount(request.AccountName)
+	if err == nil || (err == errAccountDoesNotExist && request.Erase) {
+		// ERASE also removes the records of an already unregistered account
+		if unregisterErr := a.server.accounts.Unregister(request.AccountName, request.Erase); unregisterErr != nil && err == nil {
+			err = unregisterErr
+		}
+	}
+	switch err {
+	case nil:
+		response.Success = true
+		verb := "unregistered"
+		if request.Erase {
+			verb = "erased"
+		}
+		a.server.logger.Info("api", verb, "account", request.AccountName)
+		a.server.snomasks.Send(sno.LocalAccounts, fmt.Sprintf("API %s account %s", verb, request.AccountName))
+	case errAccountDoesNotExist:
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+	default:
+		a.server.logger.Error("api", "could not unregister account:", err.Error())
+		response.ErrorCode = "UNKNOWN_ERROR"
+	}
+
+	a.writeJSONResponse(response, w, r)
+}
+
