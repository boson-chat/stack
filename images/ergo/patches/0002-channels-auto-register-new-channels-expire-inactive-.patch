+func TestNoteActivity(t *testing.T) {
+	server := channelExpiryTestServer(t, 30*day, RegisteredChannel{Name: "#chan", Founder: "alice", RegisteredAt: time.Now().Add(-day)})
+	channel := server.channels.Get("#chan")
+	if !channel.LastActivity().IsZero() {
+		t.Fatalf("unexpected last activity %v", channel.LastActivity())
+	}
+
+	channel.noteActivity()
+	first := channel.LastActivity()
+	if time.Since(first) > time.Minute {
+		t.Fatalf("activity not recorded: %v", first)
+	}
+	eventually(t, "activity persisted", func() bool {
+		r, _ := storedChannel(t, server, "#chan")
+		return r.LastActivity.Equal(first)
+	})
+
+	// within the resolution, nothing changes (and nothing is written)
+	channel.noteActivity()
+	if !channel.LastActivity().Equal(first) {
+		t.Errorf("activity updated within the resolution")
+	}
+
+	// a stale time is refreshed
+	stale := time.Now().Add(-2 * time.Hour).UnixNano()
+	channel.lastActivity.Store(stale)
+	channel.noteActivity()
+	if channel.lastActivity.Load() == stale {
+		t.Errorf("stale activity not refreshed")
+	}
+}
+
+func TestSetRegisteredStartsExpiryClock(t *testing.T) {
+	server := channelExpiryTestServer(t, 30*day)
+	channel := NewChannel(server, "#new", "#new", false, RegisteredChannel{})
+	channel.lastActivity.Store(time.Now().Add(-100 * day).UnixNano())
+	if err := channel.SetRegistered("bob"); err != nil {
+		t.Fatal(err)
+	}
+	if time.Since(channel.LastActivity()) > time.Minute {
+		t.Errorf("registration should reset the last activity, got %v", channel.LastActivity())
+	}
+	if channel.ExportRegistration().LastActivity.IsZero() {
+		t.Errorf("last activity not exported")
+	}
+}
