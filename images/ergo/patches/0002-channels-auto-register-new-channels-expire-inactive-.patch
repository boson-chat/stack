diff --git a/irc/channelexpiry.go b/irc/channelexpiry.go
new file mode 100644
index 00000000..329f6242
--- /dev/null
+++ b/irc/channelexpiry.go
@@ -0,0 +1,231 @@
+// Copyright (c) 2026 The Ergo contributors
+// released under the MIT license
+
+package irc
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/ergochat/irc-go/ircfmt"
+
+	"github.com/ergochat/ergo/irc/modes"
+	"github.com/ergochat/ergo/irc/sno"
+)
+
+// Lifecycle of channel registrations:
+//
+//   - channels.registration.auto-register: a channel created by a logged-in
+//     client (by joining it) is registered to their account right away, as if
+//     they had run /CS REGISTER.
+//   - channels.registration.expire-after: a registered channel that has seen no
+//     JOIN, PRIVMSG or NOTICE for that long is unregistered. Its founder is
+//     warned beforehand (on the next check if they're online, and at every
+//     login during the warning period otherwise). Operators with the chanreg
+//     capability can exempt a channel with /CS SET #channel EXPIRY OFF.
+//
+// Activity is tracked in memory on every message and written back to the
+// database at most once per channelActivityResolution per channel.
+
+const (
+	// maximum interval between expiration checks, and maximum staleness of
+	// the stored last-activity time
+	channelActivityResolution = time.Hour
+	// how long before expiration the founder is warned
+	channelExpiryWarning = 7 * 24 * time.Hour
+)
+
+// channelActivityInterval is how stale a stored last-activity time may get, and
+// how often expiration is checked: an hour, or less for short expire-after
+// values (which are mostly useful for testing).
+func channelActivityInterval(expireAfter time.Duration) time.Duration {
+	if expireAfter <= 0 {
+		return channelActivityResolution
+	}
+	return min(channelActivityResolution, max(expireAfter/10, time.Second))
+}
+
+// channelExpiryWarningPeriod is how long before expiration the founder is warned.
+func channelExpiryWarningPeriod(expireAfter time.Duration) time.Duration {
+	return min(channelExpiryWarning, expireAfter/4)
+}
+
+func (channel *Channel) LastActivity() time.Time {
+	if ns := channel.lastActivity.Load(); ns != 0 {
+		return time.Unix(0, ns).UTC()
+	}
+	return time.Time{}
+}
+
+// noteActivity records a JOIN or message. It's cheap enough to call for every
+// message: the registration is only written back when the stored time is
+// more than channelActivityInterval old.
+func (channel *Channel) noteActivity() {
+	expireAfter := time.Duration(channel.server.Config().Channels.Registration.ExpireAfter)
+	now := time.Now().UnixNano()
+	last := channel.lastActivity.Load()
+	if now-last < int64(channelActivityInterval(expireAfter)) {
+		return
+	}
+	if channel.lastActivity.CompareAndSwap(last, now) {
+		channel.MarkDirty(IncludeActivity) // no-op for unregistered channels
+	}
+}
+
+type channelExpiryStatus uint
+
+const (
+	channelNotExpiring channelExpiryStatus = iota
+	channelExpiringSoon
+	channelExpired
+)
+
+// channelExpiry decides what happens to a registered channel whose last
+// activity was at lastActivity, and when it will expire.
+func channelExpiry(expireAfter time.Duration, exempt bool, lastActivity, now time.Time) (status channelExpiryStatus, expiresAt time.Time) {
+	if expireAfter <= 0 || exempt || lastActivity.IsZero() {
+		return channelNotExpiring, time.Time{}
+	}
+	expiresAt = lastActivity.Add(expireAfter)
+	switch {
+	case !now.Before(expiresAt):
+		status = channelExpired
+	case !now.Before(expiresAt.Add(-channelExpiryWarningPeriod(expireAfter))):
+		status = channelExpiringSoon
+	}
+	return
+}
+
+// formatChannelExpiry formats a duration for humans, approximately ("90 days").
+func formatChannelExpiry(d time.Duration) string {
+	const day = 24 * time.Hour
+	switch {
+	case d == day:
+		return "1 day"
+	case d%day == 0 || d >= 2*day:
+		return fmt.Sprintf("%d days", (d+day/2)/day)
+	case d >= 2*time.Hour:
+		return fmt.Sprintf("%d hours", (d+time.Hour/2)/time.Hour)
+	default:
+		return d.Round(time.Second).String()
+	}
+}
+
+func (server *Server) periodicChannelExpiry() {
+	interval := channelActivityResolution
+	defer func() {
+		// reschedule whether or not there was a panic
+		time.AfterFunc(interval, server.periodicChannelExpiry)
+	}()
+
+	defer server.HandlePanic(nil)
+
+	config := server.Config()
+	interval = channelActivityInterval(time.Duration(config.Channels.Registration.ExpireAfter))
+	server.performChannelExpiry(config, time.Now().UTC())
+}
+
+func (server *Server) performChannelExpiry(config *Config, now time.Time) {
+	expireAfter := time.Duration(config.Channels.Registration.ExpireAfter)
+	for _, channel := range server.channels.registeredChannels() {
+		lastActivity := channel.LastActivity()
+		if lastActivity.IsZero() {
+			// registered before activity was tracked: start the clock now
+			channel.lastActivity.CompareAndSwap(0, now.UnixNano())
+			channel.MarkDirty(IncludeActivity)
+			continue
+		}
+		status, expiresAt := channelExpiry(expireAfter, channel.Settings().NoExpire, lastActivity, now)
+		switch status {
+		case channelExpired:
+			server.expireChannel(channel, expireAfter)
+		case channelExpiringSoon:
+			if channel.expiryWarned.Load() != lastActivity.UnixNano() {
+				clients := server.accounts.AccountToClients(channel.Founder())
+				for _, client := range clients {
+					client.Send(nil, chanservService.prefix, "NOTICE", client.Nick(), channelExpiryWarningText(client, channel.Name(), lastActivity, expiresAt, now))
+				}
+				if len(clients) != 0 {
+					channel.expiryWarned.Store(lastActivity.UnixNano())
+				}
+			}
+		}
+	}
+}
+
+func channelExpiryWarningText(client *Client, chname string, lastActivity, expiresAt, now time.Time) string {
+	return fmt.Sprintf(client.t("Channel %[1]s has had no activity since %[2]s and will be unregistered in %[3]s (%[4]s) unless someone joins it or talks in it"),
+		chname, lastActivity.Format(time.RFC1123), formatChannelExpiry(expiresAt.Sub(now)), expiresAt.Format(time.RFC1123))
+}
+
+func (server *Server) expireChannel(channel *Channel, expireAfter time.Duration) {
+	founder, chname := channel.Founder(), channel.Name()
+	if err := server.channels.SetUnregistered(channel.NameCasefolded(), founder); err != nil {
+		server.logger.Error("services", "couldn't expire channel", chname, err.Error())
+		return
+	}
+	idle := formatChannelExpiry(expireAfter)
+	server.logger.Info("services", fmt.Sprintf("Channel %s expired after %s without activity, unregistered (founder: %s)", chname, idle, founder))
+	server.snomasks.Send(sno.LocalChannels, fmt.Sprintf(ircfmt.Unescape("Channel $c[grey][$r%s$c[grey]] expired after %s without activity and was unregistered (founder: $c[grey][$r%s$c[grey]])"), chname, idle, founder))
+	for _, client := range server.accounts.AccountToClients(founder) {
+		client.Send(nil, chanservService.prefix, "NOTICE", client.Nick(), fmt.Sprintf(client.t("Channel %[1]s was unregistered because it had no activity for %[2]s"), chname, idle))
+	}
+}
+
+// warnOfChannelExpiry reminds a client who just logged in about the channels
+// they founded that are about to expire.
+func (server *Server) warnOfChannelExpiry(client *Client, rb *ResponseBuffer) {
+	config := server.Config()
+	expireAfter := time.Duration(config.Channels.Registration.ExpireAfter)
+	account := client.Account()
+	if expireAfter <= 0 || account == "" {
+		return
+	}
+	now := time.Now().UTC()
+	for _, cfname := range server.channels.ChannelsForAccount(account, true) {
+		channel := server.channels.Get(cfname)
+		if channel == nil {
+			continue
+		}
+		lastActivity := channel.LastActivity()
+		if status, expiresAt := channelExpiry(expireAfter, channel.Settings().NoExpire, lastActivity, now); status == channelExpiringSoon {
+			rb.Add(nil, chanservService.prefix, "NOTICE", client.Nick(), channelExpiryWarningText(client, channel.Name(), lastActivity, expiresAt, now))
+			channel.expiryWarned.Store(lastActivity.UnixNano())
+		}
+	}
+}
+
+// registeredChannels returns all registered channels.
+func (cm *ChannelManager) registeredChannels() (result []*Channel) {
+	cm.RLock()
+	defer cm.RUnlock()
+	for _, entry := range cm.chans {
+		if entry.channel.Founder() != "" {
+			result = append(result, entry.channel)
+		}
+	}
+	return
+}
+
+// csAutoRegister registers a channel that client has just created by joining
+// it (channels.registration.auto-register), provided that client could have
+// registered it with /CS REGISTER.
+func csAutoRegister(server *Server, client *Client, channel *Channel, rb *ResponseBuffer) {
+	registration := server.Config().Channels.Registration
+	if !registration.Enabled || !registration.AutoRegister || client.Account() == "" {
+		return
+	}
+	if registration.OperatorOnly && !client.HasRoleCapabs("chanreg") {
+		return
+	}
+	if !channel.ClientIsAtLeast(client, modes.ChannelOperator) {
+		return // someone else created it after all
+	}
+	if chanLimitReached(client) {
+		chanservService.Notice(rb, fmt.Sprintf(client.t("Channel %s was not registered automatically, because you have already registered the maximum number of channels"), channel.Name()))
+		return
+	}
+	if err := csRegisterChannel(chanservService, server, client, channel, rb); err != nil {
+		server.logger.Debug("services", "couldn't auto-register channel", channel.Name(), err.Error())
+	}
+}
diff --git a/irc/channelexpiry_test.go b/irc/channelexpiry_test.go
