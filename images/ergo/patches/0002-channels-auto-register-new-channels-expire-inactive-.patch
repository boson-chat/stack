+func TestAutoRegister(t *testing.T) {
+	server := channelExpiryTestServer(t, 0)
+	server.clients.Initialize()
+	chanservService.prefix = "ChanServ!ChanServ@localhost"
+	config := server.Config()
+	config.Channels.Registration.MaxChannelsPerAccount = 2
+
+	alice, rb := autoRegisterTestClient(server, "alice", "alice")
+
+	// off by default
+	first := autoRegisterTestChannel(server, alice, "#first")
+	csAutoRegister(server, alice, first, rb)
+	if first.Founder() != "" {
+		t.Fatalf("registered with auto-register off")
+	}
+
+	config.Channels.Registration.AutoRegister = true
+	csAutoRegister(server, alice, first, rb)
+	if first.Founder() != "alice" {
+		t.Fatalf("#first not registered to alice")
+	}
+	if !noticesContain(rb, "Channel #first successfully registered") {
+		t.Errorf("no ChanServ notice: %v", rb.messages)
+	}
+	if mode := first.HighestUserMode(alice); mode != modes.ChannelFounder {
+		t.Errorf("alice should be founder (+q), has %v", mode)
+	}
+	if reg, found := storedChannel(t, server, "#first"); !found || reg.Founder != "alice" {
+		t.Errorf("registration not stored")
+	}
+
+	// a guest's channel isn't registered
+	guest, guestRB := autoRegisterTestClient(server, "guest", "")
+	guestChannel := autoRegisterTestChannel(server, guest, "#guest")
+	csAutoRegister(server, guest, guestChannel, guestRB)
+	if guestChannel.Founder() != "" || len(guestRB.messages) != 0 {
+		t.Errorf("guest channel registered: %q, %v", guestChannel.Founder(), guestRB.messages)
+	}
+
+	// someone who isn't a channel operator (didn't create it) isn't its founder
+	bob, bobRB := autoRegisterTestClient(server, "bob", "bob")
+	notOp := autoRegisterTestChannel(server, guest, "#notop")
+	notOp.members.Add(bob)
+	notOp.regenerateMembersCache()
+	csAutoRegister(server, bob, notOp, bobRB)
+	if notOp.Founder() != "" {
+		t.Errorf("registered to a non-operator")
+	}
+
+	// max-channels-per-account is respected, with a notice
+	second := autoRegisterTestChannel(server, alice, "#second")
+	csAutoRegister(server, alice, second, rb)
+	third := autoRegisterTestChannel(server, alice, "#third")
+	rb = NewResponseBuffer(alice.Sessions()[0])
+	csAutoRegister(server, alice, third, rb)
+	if second.Founder() != "alice" || third.Founder() != "" {
+		t.Errorf("limit not respected: #second %q, #third %q", second.Founder(), third.Founder())
+	}
+	if !noticesContain(rb, "maximum number of channels") {
+		t.Errorf("no limit notice: %v", rb.messages)
+	}
+
+	// operator-only registration: only opers with chanreg
+	config.Channels.Registration.OperatorOnly = true
+	carol, carolRB := autoRegisterTestClient(server, "carol", "carol")
+	opOnly := autoRegisterTestChannel(server, carol, "#oponly")
+	csAutoRegister(server, carol, opOnly, carolRB)
+	if opOnly.Founder() != "" {
+		t.Errorf("registered under operator-only")
+	}
+	carol.oper = &Oper{Class: &OperClass{Capabilities: utils.HashSet[string]{"chanreg": {}}}}
+	csAutoRegister(server, carol, opOnly, carolRB)
+	if opOnly.Founder() != "carol" {
+		t.Errorf("chanreg oper's channel not registered under operator-only")
+	}
+}
