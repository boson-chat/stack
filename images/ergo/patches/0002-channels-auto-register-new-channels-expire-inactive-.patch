+func autoRegisterTestClient(server *Server, nick, account string) (*Client, *ResponseBuffer) {
+	client := &Client{server: server, nick: nick, nickCasefolded: nick, account: account, accountName: account}
+	session := &Session{client: client}
+	client.sessions = []*Session{session}
+	server.clients.byNick[nick] = client
+	return client, NewResponseBuffer(session)
+}
+
+// creates a channel the way JOIN does: client is its only member, with +o
+func autoRegisterTestChannel(server *Server, client *Client, name string) *Channel {
+	channel := NewChannel(server, name, name, false, RegisteredChannel{})
+	server.channels.Lock()
+	server.channels.chans[name] = &channelManagerEntry{channel: channel, pendingJoins: 1}
+	server.channels.Unlock()
+	channel.members.Add(client)
+	channel.members[client].modes.SetMode(modes.ChannelOperator, true)
+	channel.regenerateMembersCache()
+	return channel
+}
+
+func noticesContain(rb *ResponseBuffer, text string) bool {
+	for _, msg := range rb.messages {
+		if msg.Command == "NOTICE" && strings.Contains(msg.Params[len(msg.Params)-1], text) {
+			return true
+		}
+	}
+	return false
+}
