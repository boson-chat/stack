index 00000000..82f63743
--- /dev/null
+++ b/irc/channelexpiry_test.go
@@ -0,0 +1,392 @@
+// Copyright (c) 2026 The Ergo contributors
+// released under the MIT license
+
+package irc
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/tidwall/buntdb"
+
+	"github.com/ergochat/ergo/irc/bunt"
+	"github.com/ergochat/ergo/irc/custime"
+	"github.com/ergochat/ergo/irc/datastore"
+	"github.com/ergochat/ergo/irc/languages"
+	"github.com/ergochat/ergo/irc/logger"
+	"github.com/ergochat/ergo/irc/modes"
+	"github.com/ergochat/ergo/irc/utils"
+)
+
+const day = 24 * time.Hour
+
+func TestChannelActivityInterval(t *testing.T) {
+	cases := []struct {
+		expireAfter, want time.Duration
+	}{
+		{0, time.Hour},
+		{90 * day, time.Hour},
+		{10 * time.Hour, time.Hour},
+		{5 * time.Hour, 30 * time.Minute},
+		{20 * time.Second, 2 * time.Second},
+		{2 * time.Second, time.Second},
+	}
+	for _, c := range cases {
+		if got := channelActivityInterval(c.expireAfter); got != c.want {
+			t.Errorf("channelActivityInterval(%v) = %v, want %v", c.expireAfter, got, c.want)
+		}
+	}
+	if got := channelExpiryWarningPeriod(90 * day); got != 7*day {
+		t.Errorf("warning period for 90 days: %v", got)
+	}
+	if got := channelExpiryWarningPeriod(20 * time.Second); got != 5*time.Second {
+		t.Errorf("warning period for 20s: %v", got)
+	}
+}
+
+func TestChannelExpiry(t *testing.T) {
+	now := time.Date(2026, 11, 14, 12, 0, 0, 0, time.UTC)
+	cases := []struct {
+		name         string
+		expireAfter  time.Duration
+		exempt       bool
+		lastActivity time.Time
+		want         channelExpiryStatus
+	}{
+		{"disabled", 0, false, now.Add(-1000 * day), channelNotExpiring},
+		{"exempt", 30 * day, true, now.Add(-1000 * day), channelNotExpiring},
+		{"untracked", 30 * day, false, time.Time{}, channelNotExpiring},
+		{"active", 30 * day, false, now.Add(-time.Hour), channelNotExpiring},
+		{"just before the warning", 30 * day, false, now.Add(-23*day + time.Minute), channelNotExpiring},
+		{"warning starts", 30 * day, false, now.Add(-23 * day), channelExpiringSoon},
+		{"about to expire", 30 * day, false, now.Add(-30*day + time.Minute), channelExpiringSoon},
+		{"expires", 30 * day, false, now.Add(-30 * day), channelExpired},
+		{"long gone", 30 * day, false, now.Add(-300 * day), channelExpired},
+	}
+	for _, c := range cases {
+		status, expiresAt := channelExpiry(c.expireAfter, c.exempt, c.lastActivity, now)
+		if status != c.want {
+			t.Errorf("%s: got status %d, want %d", c.name, status, c.want)
+		}
+		if status != channelNotExpiring && !expiresAt.Equal(c.lastActivity.Add(c.expireAfter)) {
+			t.Errorf("%s: expiresAt %v", c.name, expiresAt)
+		}
+	}
+}
+
+func TestFormatChannelExpiry(t *testing.T) {
+	cases := map[time.Duration]string{
+		day:                              "1 day",
+		90 * day:                         "90 days",
+		7*day - time.Minute:              "7 days",
+		6*day + 11*time.Hour:             "6 days",
+		36 * time.Hour:                   "36 hours",
+		3 * time.Hour:                    "3 hours",
+		90 * time.Minute:                 "1h30m0s",
+		20 * time.Second:                 "20s",
+		20*time.Second + time.Nanosecond: "20s",
+	}
+	for d, want := range cases {
+		if got := formatChannelExpiry(d); got != want {
+			t.Errorf("formatChannelExpiry(%v) = %q, want %q", d, got, want)
+		}
+	}
+}
+
+func TestRegisteredChannelLastActivity(t *testing.T) {
+	// records written before activity tracking deserialize with a zero time
+	var old RegisteredChannel
+	if err := old.Deserialize([]byte(`{"Name":"#old","Founder":"alice","Settings":{"History":0,"QueryCutoff":0,"StoreEvents":0}}`)); err != nil {
+		t.Fatal(err)
+	}
+	if !old.LastActivity.IsZero() || old.Settings.NoExpire {
+		t.Errorf("unexpected %#v", old)
+	}
+
+	when := time.Date(2026, 11, 1, 0, 0, 0, 0, time.UTC)
+	reg := RegisteredChannel{Name: "#new", Founder: "alice", LastActivity: when, Settings: ChannelSettings{NoExpire: true}}
+	b, err := reg.Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var back RegisteredChannel
+	if err := back.Deserialize(b); err != nil {
+		t.Fatal(err)
+	}
+	if !back.LastActivity.Equal(when) || !back.Settings.NoExpire {
+		t.Errorf("round trip lost fields: %s", b)
+	}
+}
+
+func channelExpiryTestServer(t *testing.T, expireAfter time.Duration, regs ...RegisteredChannel) *Server {
+	t.Helper()
+	lm, err := languages.NewManager(false, "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := &Config{languageManager: lm}
+	config.Channels.Registration.Enabled = true
+	config.Channels.Registration.ExpireAfter = custime.Duration(expireAfter)
+	server := &Server{name: "ergo.test"}
+	server.defcon.Store(5)
+	server.config.Store(config)
+	if server.logger, err = logger.NewManager(nil); err != nil {
+		t.Fatal(err)
+	}
+	server.snomasks.Initialize()
+	db, err := buntdb.Open(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	server.dstore = bunt.NewBuntdbDatastore(db, server.logger)
+	for _, reg := range regs {
+		reg.UUID = utils.GenerateUUIDv4()
+		reg.Settings.History = HistoryDefault
+		b, err := reg.Serialize()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := server.dstore.Set(datastore.TableChannels, reg.UUID, b, time.Time{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := server.channels.Initialize(server, config); err != nil {
+		t.Fatal(err)
+	}
+	return server
+}
+
+func storedChannel(t *testing.T, server *Server, name string) (reg RegisteredChannel, found bool) {
+	t.Helper()
+	all, err := FetchAndDeserializeAll[RegisteredChannel](datastore.TableChannels, server.dstore, server.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, r := range all {
+		if r.Name == name {
+			return r, true
+		}
+	}
+	return
+}
+
+func eventually(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	for i := 0; i < 200; i++ {
+		if cond() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Errorf("timed out waiting for: %s", what)
+}
+
+func TestPerformChannelExpiry(t *testing.T) {
+	now := time.Now().UTC().Truncate(time.Second)
+	registered := now.Add(-400 * day)
+	reg := func(name string, lastActivity time.Time, exempt bool) RegisteredChannel {
+		return RegisteredChannel{Name: name, Founder: "alice", RegisteredAt: registered, LastActivity: lastActivity,
+			Settings: ChannelSettings{NoExpire: exempt}}
+	}
+	server := channelExpiryTestServer(t, 30*day,
+		reg("#idle", now.Add(-31*day), false),
+		reg("#quiet", now.Add(-25*day), false),
+		reg("#busy", now.Add(-time.Hour), false),
+		reg("#exempt", now.Add(-300*day), true),
+		reg("#legacy", time.Time{}, false),
+	)
+
+	server.performChannelExpiry(server.Config(), now)
+
+	if server.channels.Get("#idle") != nil {
+		t.Errorf("#idle should have been unregistered and cleaned up")
+	}
+	eventually(t, "#idle deleted from the database", func() bool {
+		_, found := storedChannel(t, server, "#idle")
+		return !found
+	})
+	for _, name := range []string{"#quiet", "#busy", "#exempt", "#legacy"} {
+		if ch := server.channels.Get(name); ch == nil || ch.Founder() != "alice" {
+			t.Errorf("%s should still be registered", name)
+		}
+	}
+	// the clock starts now for channels registered before tracking, and that is persisted
+	if got := server.channels.Get("#legacy").LastActivity(); !got.Equal(now) {
+		t.Errorf("#legacy last activity %v, want %v", got, now)
+	}
+	eventually(t, "#legacy last activity persisted", func() bool {
+		r, _ := storedChannel(t, server, "#legacy")
+		return r.LastActivity.Equal(now)
+	})
+
+	// 7 days later #quiet expires too; #legacy is now in its warning period
+	server.performChannelExpiry(server.Config(), now.Add(7*day))
+	if server.channels.Get("#quiet") != nil {
+		t.Errorf("#quiet should have expired")
+	}
+	if server.channels.Get("#legacy") == nil || server.channels.Get("#exempt") == nil {
+		t.Errorf("#legacy and #exempt should still be registered")
+	}
+
+	// with expiration off nothing expires
+	server.Config().Channels.Registration.ExpireAfter = 0
+	server.performChannelExpiry(server.Config(), now.Add(1000*day))
+	if server.channels.Get("#legacy") == nil || server.channels.Get("#busy") == nil {
+		t.Errorf("channels expired with expire-after 0")
+	}
+}
