+type apiAccountGrantsRequest struct {
+	AccountName string `json:"accountName"`
+	AccountGrants
+}
+
+type apiAccountGrantsResponse struct {
+	apiGenericResponse
+	// connected clients of the account whose operator status was synced
+	Clients int `json:"clients"`
+}
+
+// handleAccountGrants applies the same grants an auth-script can return at
+// login (operClass, whoisLine, vhost) to an account and its clients now.
+func (a *ergoAPI) handleAccountGrants(w http.ResponseWriter, r *http.Request) {
+	var request apiAccountGrantsRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+
+	var response apiAccountGrantsResponse
+	clients, err := a.server.accounts.ApplyAccountGrants(request.AccountName, request.AccountGrants)
+	switch {
+	case err == nil:
+		response.Success = true
+		response.Clients = clients
+	case errors.Is(err, errAccountDoesNotExist), errors.Is(err, errAccountUnverified):
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+	case errors.Is(err, errUnknownOperClass):
+		response.ErrorCode = "UNKNOWN_OPER_CLASS"
+		response.Error = err.Error()
+	case errors.Is(err, errVHostBadCharacters):
+		response.ErrorCode = "INVALID_VHOST"
+	case errors.Is(err, errFeatureDisabled):
+		response.ErrorCode = "FEATURE_DISABLED"
+	default:
+		a.server.logger.Error("api", "could not apply account grants:", err.Error())
+		response.ErrorCode = "UNKNOWN_ERROR"
+	}
+
+	a.writeJSONResponse(response, w, r)
+}
