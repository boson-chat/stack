--- /dev/null
+++ b/irc/accountopers.go
@@ -0,0 +1,269 @@
+// Copyright (c) 2026 The Ergo contributors
+// released under the MIT license
+
+package irc
+
+// Account-bound operator status ("account opers").
+//
+// Ergo's opers authenticate with /OPER (password and/or certfp). When accounts
+// live in an external system (auth-script), that system usually also knows
+// who the network's staff are. These helpers let it say so:
+//
+//   - the auth-script may return `operClass` (and optionally `whoisLine` and
+//     `vhost`) with a successful login. The client is opered up into that
+//     class when registration completes (or at once, for a login after
+//     registration, e.g. NickServ IDENTIFY), and the vhost is stored as the
+//     account's HostServ vhost.
+//   - POST /v1/account_grants (HTTP API) applies the same fields to an
+//     account at any time, including to its connected clients, so changes
+//     made in the external system can take effect without a reconnect.
+//   - on rehash, account-bound opers pick up their class's new definition,
+//     and are de-opered if the class no longer exists.
+//
+// Operators who opered up with /OPER are never touched by any of this.
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/ergochat/ergo/irc/modes"
+)
+
+var errUnknownOperClass = errors.New("unknown oper class")
+
+// AccountGrants are the optional privileges an external system (auth-script
+// output or the account_grants API) can attach to an account.
+type AccountGrants struct {
+	// OperClass is the name of an oper-classes entry. nil = no opinion
+	// (leave things as they are); "" = the account is not an operator.
+	OperClass *string `json:"operClass,omitempty"`
+	// WhoisLine overrides the class's whois-line (RPL_WHOISOPERATOR).
+	WhoisLine string `json:"whoisLine,omitempty"`
+	// VHost is stored as the account's vhost (as with HostServ SET).
+	// nil = leave it alone; "" = remove it.
+	VHost *string `json:"vhost,omitempty"`
+}
+
+// accountOper builds the Oper for an account-bound grant. It returns nil, nil
+// when the grant doesn't make the account an operator.
+func (conf *Config) accountOper(accountName string, g AccountGrants) (*Oper, error) {
+	if g.OperClass == nil || *g.OperClass == "" {
+		return nil, nil
+	}
+	cfAccount, err := CasefoldName(accountName)
+	if err != nil {
+		return nil, err
+	}
+	class := conf.operClasses[*g.OperClass]
+	if class == nil {
+		return nil, fmt.Errorf("%w %q", errUnknownOperClass, *g.OperClass)
+	}
+	oper := &Oper{
+		Name:             cfAccount,
+		Class:            class,
+		WhoisLine:        class.WhoisLine,
+		account:          cfAccount,
+		className:        *g.OperClass,
+		accountWhoisLine: sanitizeGrantedWhoisLine(g.WhoisLine),
+	}
+	if oper.accountWhoisLine != "" {
+		oper.WhoisLine = oper.accountWhoisLine
+	}
+	return oper, nil
+}
+
+// sanitizeGrantedWhoisLine drops control characters (and so CR/LF).
+func sanitizeGrantedWhoisLine(line string) string {
+	return strings.TrimSpace(strings.Map(func(r rune) rune {
+		if r < 0x20 || r == 0x7f {
+			return -1
+		}
+		return r
+	}, line))
+}
+
+// validGrantedVHost reports whether vhost ("" = none) passes the same checks
+// as HostServ SET.
+func (conf *Config) validGrantedVHost(vhost string) bool {
+	if vhost == "" {
+		return true
+	}
+	return len(vhost) <= conf.Accounts.VHosts.MaxLength && conf.Accounts.VHosts.validRegexp.MatchString(vhost)
+}
+
+// refreshedAccountOper returns the Oper an account-bound oper should have
+// under conf: the same grant against conf's oper classes, or nil if its class
+// is gone. ok is false if oper is not account-bound.
+func (conf *Config) refreshedAccountOper(oper *Oper) (refreshed *Oper, ok bool) {
+	if oper == nil || oper.account == "" {
+		return nil, false
+	}
+	refreshed, err := conf.accountOper(oper.account, AccountGrants{OperClass: &oper.className, WhoisLine: oper.accountWhoisLine})
+	if err != nil {
+		return nil, true
+	}
+	return refreshed, true
+}
+
+// applyGrantedVHost stores a granted vhost as the account's vhost, unless it
+// already is (so a login doesn't write to the datastore, and a user's
+// HostServ OFF is kept).
+func (am *AccountManager) applyGrantedVHost(accountName string, vhost *string) error {
+	config := am.server.Config()
+	if vhost == nil || !config.Accounts.VHosts.Enabled {
+		return nil
+	}
+	if !config.validGrantedVHost(*vhost) {
+		return errVHostBadCharacters
+	}
+	account, err := am.LoadAccount(accountName)
+	if err != nil {
+		return err
+	}
+	if account.VHost.ApprovedVHost == *vhost {
+		return nil
+	}
+	_, err = am.VHostSet(accountName, *vhost)
+	return err
+}
+
+// applyLoginGrants handles the grants in a successful auth-script response.
+// client has just been logged into accountName. The oper class is applied
+// later, by sendSuccessfulAccountAuth / attemptAutoOper, so that a login that
+// is undone (e.g. by the nick-equals-account check) grants nothing.
+func (am *AccountManager) applyLoginGrants(client *Client, accountName string, g AccountGrants) {
+	if err := am.applyGrantedVHost(accountName, g.VHost); err != nil {
+		am.server.logger.Warning("accounts", "could not apply vhost from auth-script for", accountName, err.Error())
+	}
+	oper, err := am.server.Config().accountOper(accountName, g)
+	if err != nil {
+		am.server.logger.Error("accounts", "could not apply oper class from auth-script for", accountName, err.Error())
+	}
+	client.setPendingOper(oper)
+}
+
+func (client *Client) setPendingOper(oper *Oper) {
+	client.stateMutex.Lock()
+	defer client.stateMutex.Unlock()
+	client.pendingOper = oper
+}
+
+func (client *Client) takePendingOper() (oper *Oper) {
+	client.stateMutex.Lock()
+	defer client.stateMutex.Unlock()
+	oper, client.pendingOper = client.pendingOper, nil
+	return
+}
+
+// handOffPendingOper is called once a login has fully succeeded. Before
+// registration, the grant moves to the session (it may end up attached to a
+// different, always-on Client) and is applied by attemptAutoOper; after
+// registration it is applied immediately.
+func (client *Client) handOffPendingOper(rb *ResponseBuffer) {
+	oper := client.takePendingOper()
+	if oper == nil || oper.account != client.Account() {
+		return
+	}
+	if !client.Registered() {
+		rb.session.pendingOper = oper
+	} else if !client.HasMode(modes.Operator) {
+		applyOper(client, oper, rb)
+	}
+}
+
+// grantAccountOper opers up client (which must not be an operator yet).
+func grantAccountOper(client *Client, oper *Oper) {
+	sessions := client.Sessions()
+	if len(sessions) == 0 {
+		// an always-on client with nobody attached
+		client.SetOper(oper)
+		ApplyUserModeChanges(client, modes.ModeChanges{{Mode: modes.Operator, Op: modes.Add}}, true, oper)
+		return
+	}
+	rb := NewResponseBuffer(sessions[0])
+	applyOper(client, oper, rb)
+	rb.Send(true)
+}
+
+// revokeAccountOper de-opers client and tells its sessions.
+func revokeAccountOper(client *Client) {
+	applied := ApplyUserModeChanges(client, modes.ModeChanges{{Mode: modes.Operator, Op: modes.Remove}}, true, nil)
+	if len(applied) == 0 {
+		return
+	}
+	details := client.Details()
+	args := append([]string{details.nick}, applied.Strings()...)
+	for _, session := range client.Sessions() {
+		session.Send(nil, client.server.name, "MODE", args...)
+	}
+	client.server.logger.Info("opers", details.nick, "lost account-bound operator status")
+}
+
+// syncAccountOper brings one client in line with oper (nil = not an
+// operator). Clients opered with /OPER are left alone.
+func syncAccountOper(client *Client, oper *Oper) {
+	current := client.Oper()
+	switch {
+	case current != nil && current.account == "":
+		// /OPER: not ours
+	case oper == nil:
+		if current != nil {
+			revokeAccountOper(client)
+		}
+	case current == nil:
+		// a client still registering gets its login's grant at registration
+		if client.Registered() {
+			grantAccountOper(client, oper)
+		}
+	default:
+		// already an account-bound oper: switch class / whois-line quietly
+		client.SetOper(oper)
+	}
+}
+
+// ApplyAccountGrants applies g to accountName and to all its clients now.
+// It returns the number of clients whose oper status was synced.
+func (am *AccountManager) ApplyAccountGrants(accountName string, g AccountGrants) (clients int, err error) {
+	cfAccount, err := CasefoldName(accountName)
+	if err != nil {
+		return 0, errAccountDoesNotExist
+	}
+	if _, err = am.LoadAccount(cfAccount); err != nil {
+		return 0, err
+	}
+	config := am.server.Config()
+	if g.VHost != nil && !config.validGrantedVHost(*g.VHost) {
+		return 0, errVHostBadCharacters
+	}
+	var oper *Oper
+	if g.OperClass != nil {
+		if oper, err = config.accountOper(cfAccount, g); err != nil {
+			return 0, err
+		}
+	}
+	if err = am.applyGrantedVHost(cfAccount, g.VHost); err != nil {
+		return 0, err
+	}
+	if g.OperClass == nil {
+		return 0, nil
+	}
+	am.RLock()
+	targets := make([]*Client, len(am.accountToClients[cfAccount]))
+	copy(targets, am.accountToClients[cfAccount])
+	am.RUnlock()
+	for _, client := range targets {
+		syncAccountOper(client, oper)
+	}
+	return len(targets), nil
+}
+
+// refreshAccountOpers re-resolves every account-bound oper against config
+// (after a rehash): class changes apply at once, removed classes de-oper.
+func (server *Server) refreshAccountOpers(config *Config) {
+	for _, client := range server.clients.AllClients() {
+		if refreshed, ok := config.refreshedAccountOper(client.Oper()); ok {
+			syncAccountOper(client, refreshed)
+		}
+	}
+}
diff --git a/irc/accountopers_test.go b/irc/accountopers_test.go
new file mode 100644
index 00000000..118772c4
--- /dev/null
+++ b/irc/accountopers_test.go
@@ -0,0 +1,185 @@
+// Copyright (c) 2026 The Ergo contributors
+// released under the MIT license
+
+package irc
+
+import (
+	"encoding/json"
+	"errors"
+	"regexp"
+	"testing"
+)
+
+func accountOpersTestConfig(t *testing.T) *Config {
+	var config Config
+	config.OperClasses = map[string]*OperClassConfig{
+		"helper": {
+			Title:        "Helper",
+			Capabilities: []string{"nofakelag"},
+		},
+		"moderator": {
+			Title:        "Moderator",
+			WhoisLine:    "is a network moderator",
+			Extends:      "helper",
+			Capabilities: []string{"kill", "ban"},
+		},
+	}
+	ocs, err := config.OperatorClasses()
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.operClasses = ocs
+	config.Accounts.VHosts.Enabled = true
+	config.Accounts.VHosts.MaxLength = 64
+	config.Accounts.VHosts.validRegexp = regexp.MustCompile(`^[0-9A-Za-z.\-_/]+$`)
+	return &config
+}
+
+func strPtr(s string) *string {
+	return &s
+}
+
+func TestAuthScriptOutputGrants(t *testing.T) {
+	var output AuthScriptOutput
+	err := json.Unmarshal([]byte(`{"success": true, "accountName": "Alice", "operClass": "moderator", "whoisLine": "is the boss", "vhost": "staff/alice"}`), &output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !output.Success || output.AccountName != "Alice" {
+		t.Errorf("unexpected output %#v", output)
+	}
+	if output.OperClass == nil || *output.OperClass != "moderator" || output.WhoisLine != "is the boss" || output.VHost == nil || *output.VHost != "staff/alice" {
+		t.Errorf("unexpected grants %#v", output.AccountGrants)
+	}
+
+	// a script that knows nothing about grants: no opinion on anything
+	output = AuthScriptOutput{}
+	if err := json.Unmarshal([]byte(`{"success": true, "accountName": "bob"}`), &output); err != nil {
+		t.Fatal(err)
+	}
+	if output.OperClass != nil || output.VHost != nil {
+		t.Errorf("grants should be unset, got %#v", output.AccountGrants)
+	}
+
+	// explicit "" means "not an operator" / "no vhost", distinct from absent
+	output = AuthScriptOutput{}
+	if err := json.Unmarshal([]byte(`{"success": true, "accountName": "bob", "operClass": "", "vhost": ""}`), &output); err != nil {
+		t.Fatal(err)
+	}
+	if output.OperClass == nil || *output.OperClass != "" || output.VHost == nil || *output.VHost != "" {
+		t.Errorf("explicit empty grants should be set, got %#v", output.AccountGrants)
+	}
+}
+
+func TestAccountOper(t *testing.T) {
+	config := accountOpersTestConfig(t)
+
+	oper, err := config.accountOper("Alice", AccountGrants{OperClass: strPtr("moderator")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if oper.Name != "alice" || oper.account != "alice" || oper.className != "moderator" {
+		t.Errorf("unexpected oper %#v", oper)
+	}
+	if oper.WhoisLine != "is a network moderator" {
+		t.Errorf("expected the class whois-line, got %q", oper.WhoisLine)
+	}
+	if oper.Pass != nil || oper.Certfp != "" || oper.Auto || oper.Hidden {
+		t.Errorf("account opers have no credentials and are visible: %#v", oper)
+	}
+	for _, capab := range []string{"kill", "ban", "nofakelag"} {
+		if !oper.HasRoleCapab(capab) {
+			t.Errorf("expected capability %s", capab)
+		}
+	}
+	if oper.HasRoleCapab("rehash") {
+		t.Errorf("unexpected capability rehash")
+	}
+
+	oper, err = config.accountOper("alice", AccountGrants{OperClass: strPtr("helper"), WhoisLine: "is a \r\nfriendly\x01 helper "})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if oper.WhoisLine != "is a friendly helper" {
+		t.Errorf("granted whois-line should be used and sanitized, got %q", oper.WhoisLine)
+	}
+
+	for _, g := range []AccountGrants{{}, {OperClass: strPtr("")}, {VHost: strPtr("x")}} {
+		oper, err = config.accountOper("alice", g)
+		if oper != nil || err != nil {
+			t.Errorf("%#v should grant nothing, got %#v, %v", g, oper, err)
+		}
+	}
+
+	_, err = config.accountOper("alice", AccountGrants{OperClass: strPtr("server-admin")})
+	if !errors.Is(err, errUnknownOperClass) {
+		t.Errorf("expected errUnknownOperClass, got %v", err)
+	}
+}
+
+func TestRefreshedAccountOper(t *testing.T) {
+	config := accountOpersTestConfig(t)
+	oper, err := config.accountOper("alice", AccountGrants{OperClass: strPtr("moderator")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	custom, err := config.accountOper("bob", AccountGrants{OperClass: strPtr("moderator"), WhoisLine: "is bob"})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// /OPER opers and non-opers are not ours
+	if _, ok := config.refreshedAccountOper(nil); ok {
+		t.Error("nil oper should not be refreshed")
+	}
+	if _, ok := config.refreshedAccountOper(&Oper{Name: "admin", Class: oper.Class}); ok {
+		t.Error("password oper should not be refreshed")
+	}
+
+	// rehash: the class gains a capability and a new whois-line
+	newConfig := accountOpersTestConfig(t)
+	newConfig.OperClasses["moderator"].Capabilities = append(newConfig.OperClasses["moderator"].Capabilities, "samode")
+	newConfig.OperClasses["moderator"].WhoisLine = "is a moderator"
+	ocs, err := newConfig.OperatorClasses()
+	if err != nil {
+		t.Fatal(err)
+	}
+	newConfig.operClasses = ocs
+
+	refreshed, ok := newConfig.refreshedAccountOper(oper)
+	if !ok || refreshed == nil {
+		t.Fatalf("expected a refreshed oper, got %#v %v", refreshed, ok)
+	}
+	if !refreshed.HasRoleCapab("samode") || refreshed.WhoisLine != "is a moderator" || refreshed.account != "alice" {
+		t.Errorf("refreshed oper doesn't follow the new class: %#v", refreshed)
+	}
+	refreshed, _ = newConfig.refreshedAccountOper(custom)
+	if refreshed.WhoisLine != "is bob" {
+		t.Errorf("a granted whois-line should survive a rehash, got %q", refreshed.WhoisLine)
+	}
+
+	// rehash: the class is removed
+	delete(newConfig.operClasses, "moderator")
+	refreshed, ok = newConfig.refreshedAccountOper(oper)
+	if !ok || refreshed != nil {
+		t.Errorf("expected de-oper (nil, true), got %#v %v", refreshed, ok)
+	}
+}
+
+func TestValidGrantedVHost(t *testing.T) {
+	config := accountOpersTestConfig(t)
+	for vhost, valid := range map[string]bool{
+		"":                       true,
+		"staff/alice":            true,
+		"mod.boson.chat":         true,
+		"bad vhost":              false,
+		"bad\nvhost":             false,
+		"ünïcode":                false,
+		string(make([]byte, 65)): false,
+		"a234567890123456789012345678901234567890123456789012345678901234": true,
+	} {
+		if got := config.validGrantedVHost(vhost); got != valid {
+			t.Errorf("validGrantedVHost(%q) = %v, want %v", vhost, got, valid)
+		}
+	}
+}
