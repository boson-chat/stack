 }
 
 // handleChannelAccess syncs a channel's +i and its account invite
@@ -50,7 +62,7 @@ func (a *ergoAPI) handleChannelAccess(w http.ResponseWriter, r *http.Request) {
 	if err := a.decodeJSONRequest(&request, w, r); err != nil {
 		return
 	}
-	response := apiChannelAccessResponse{Added: []string{}, Removed: []string{}}
+	response := apiChannelAccessResponse{Added: []string{}, Removed: []string{}, Kicked: []string{}}
 	setBy := request.SetBy
 	if setBy == "" {
 		setBy = "API"
@@ -131,6 +143,19 @@ func (a *ergoAPI) handleChannelAccess(w http.ResponseWriter, r *http.Request) {
 		channel.MarkDirty(dirty)
 		channel.announceServerModes(applied)
 	}
+	if request.JoinError != nil || request.OperJoin != nil {
+		guard := channel.Guard()
+		if request.JoinError != nil {
+			guard.joinError = cleanGuardText(*request.JoinError)
+		}
+		if request.OperJoin != nil {
+			guard.opers = *request.OperJoin
+		}
+		channel.setGuard(guard)
+	}
+	if request.Kick {
+		response.Kicked = channel.kickDisallowed(cleanGuardText(request.KickReason))
+	}
 	a.writeJSONResponse(response, w, r)
 }
 
