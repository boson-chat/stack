diff --git a/irc/handlers.go b/irc/handlers.go
index 284deeb1..18f127e4 100644
--- a/irc/handlers.go
+++ b/irc/handlers.go
@@ -1523,6 +1523,15 @@ func joinHandler(server *Server, client *Client, msg ircmsg.Message, rb *Respons
 
 func sendJoinError(client *Client, name string, rb *ResponseBuffer, err error) {
 	var code, errMsg, forbiddingMode string
+	if refusal, ok := err.(*guardRefusal); ok {
+		// a channel guard's own message (POST /v1/channel_access joinError)
+		code = ERR_INVITEONLYCHAN
+		if refusal.err == errRegisteredOnly {
+			code = ERR_NEEDREGGEDNICK
+		}
+		rb.Add(nil, client.server.name, code, client.Nick(), utils.SafeErrorParam(name), refusal.text)
+		return
+	}
 	switch err {
 	case errInsufficientPrivs:
 		code, errMsg = ERR_NOSUCHCHANNEL, `Only server operators can create new channels`
