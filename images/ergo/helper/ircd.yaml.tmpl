# Ergo configuration, rendered by `boson-ergo render` at every container start
# from environment variables (see .env.example). Edit this template, not the
# rendered /ircd/ircd.yaml. Everything not set here uses Ergo's defaults; the
# full reference is Ergo's default.yaml:
# https://github.com/ergochat/ergo/blob/stable/default.yaml

network:
    name: {{ q .NetworkName }}

server:
    name: {{ q .IRCHost }}

    listeners:
        # TLS IRC. The cert comes from Traefik via certsync; SIGHUP (sent by the
        # entrypoint when certsync updates it) reloads it without dropping anyone.
        ":6697":
            tls:
                cert: {{ q .TLSCert }}
                key: {{ q .TLSKey }}
            min-tls-version: 1.2
{{- if .Plaintext }}
        # Plaintext IRC for legacy clients (IRC_PLAINTEXT=true).
        ":6667":
{{- end }}
{{- if .ServicesListener }}
        # Plaintext for in-stack services (RoleServ) on the compose network.
        # Not published on the host, not routed by Traefik.
        {{ q .ServicesListener }}: {}
{{- end }}
{{- if .WebSocket }}
        # WebSocket for web clients. Plain ws inside the compose network;
        # Traefik terminates TLS and serves it as wss://{{ .IRCHost }}/webirc.
        ":8097":
            websocket: true
{{- end }}

    sts:
        enabled: false

    websockets:
        # Pages allowed to open WebSocket connections (Origin header).
        allowed-origins:
{{- range .WebSocketOrigins }}
            - {{ q . }}
{{- end }}

    casemapping: "ascii"
    enforce-utf8: true
    lookup-hostnames: false
    check-ident: false
    coerce-ident: '~u'

    motd: "/ircd/ergo.motd"
    motd-formatting: true

    idle-timeouts:
        registration: 60s
        ping: 1m30s
        disconnect: 2m30s

    relaymsg:
        enabled: true
        separators: "/"
        available-to-chanops: true

    # Traefik (the WebSocket proxy) lives on the stack network; trust its
    # X-Forwarded-For and treat its connections as secure (it terminated TLS).
    proxy-allowed-from:
        - localhost
        - {{ q .StackSubnet }}
    secure-nets:
        - {{ q .StackSubnet }}

    max-sendq: 96k

    compatibility:
        force-trailing: true
        send-unprefixed-sasl: true
        allow-truncation: false

    ip-limits:
        count: true
        max-concurrent-connections: 16
        throttle: true
        window: 10m
        max-connections-per-window: 32
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        exempted:
            - "localhost"

    # Users see a hash like abcd1234.{{ .CloakNetname }} instead of their IP.
    # The cloak secret is generated on first start and kept in the datastore.
    ip-cloaking:
        enabled: true
        enabled-for-always-on: true
        netname: {{ q .CloakNetname }}
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        num-bits: 64

    oper-throttle: 10s

accounts:
    authentication-enabled: true

    # Accounts live in the boson auth service: sign up at https://{{ .AuthHost }}.
    # NickServ REGISTER is off; SASL / NickServ IDENTIFY go through auth-script.
    registration:
        enabled: false
        allow-before-connect: true
        throttling:
            enabled: true
            duration: 10m
            max-attempts: 30
        bcrypt-cost: 4
        verify-timeout: "32h"
        email-verification:
            enabled: false

    login-throttling:
        enabled: true
        duration: 1m
        max-attempts: 3

    skip-server-password: false
    login-via-pass-command: true
    # SCRAM needs Ergo to hold password hashes; the auth service holds them.
    advertise-scram: false

    # Guest access follows the auth service's guest_access setting
    # (IRC_REQUIRE_SASL until auth has one): when guests are off, every
    # client must log in (SASL, or PASS account:password) before
    # registering; boson-ergo watch-settings re-renders and rehashes on a
    # change. Guests already connected stay until they disconnect.
    # Exempt (IRC_REQUIRE_SASL_EXEMPT, by the client's real IP: web clients
    # behind Traefik are checked by their X-Forwarded-For address):
    require-sasl:
        enabled: {{ .RequireSASL }}
        exempted:
{{- range .RequireSASLExempt }}
            - {{ q . }}
{{- end }}

    nick-reservation:
        enabled: true
        additional-nick-limit: 0
        method: strict
        allow-custom-enforcement: false
        guest-nickname-format: "Guest-*"
        force-guest-format: false
        force-nick-equals-account: true
        forbid-anonymous-nick-changes: false

    multiclient:
        enabled: true
        allowed-by-default: true
        # Users opt in with /msg NickServ SET always-on true.
        always-on: "opt-in"
        auto-away: "opt-in"
        always-on-expiration: 90d

    vhosts:
        enabled: true
        max-length: 64
        valid-regexp: '^[0-9A-Za-z.\-_/]+$'

    default-user-modes: +i

    # Passwords are checked by the boson auth service
    # (POST {{ .AuthVerifyURL }}).
    auth-script:
        enabled: true
        command: "/usr/local/bin/boson-ergo"
        args: ["auth-script"]
        autocreate: true
        timeout: 9s
        kill-timeout: 1s
        max-concurrency: 64

    # SASL OAUTHBEARER with a boson access token (aud "boson"), verified by
    # the same auth-script against the auth service's JWKS.
    oauth2:
        enabled: {{ .OAuthBearer }}
        autocreate: true
        auth-script: true
        # Unused (auth-script validates), but Ergo wants a parseable value.
        introspection-url: "http://auth:8080/unused"
        introspection-timeout: 10s

# Text channel creation follows the auth service's channel_creation setting
# (now: {{ .ChannelCreation }}); boson-ergo watch-settings re-renders this
# file and rehashes Ergo when it changes.
#   registered: anyone can create channels; logged-in users can register them
#               with ChanServ (Ergo has no "logged-in only" creation switch;
#               turn guest_access off to keep guests out).
#   admins:     only opers with the chanreg capability (the emergency
#               /OPER {{ .OperName }}, or a network role with irc.chanreg)
#               can create or register channels;
#               they can hand them over with /msg ChanServ TRANSFER.
channels:
    default-modes: +ntC
    max-channels-per-client: 100
    operator-only-creation: {{ .OperatorOnlyCreation }}
    registration:
        enabled: true
        operator-only: {{ .OperatorOnlyCreation }}
        max-channels-per-account: 15
        # channel_auto_register (auth): a logged-in user's new channel is
        # registered to them when they create it by joining it
        auto-register: {{ .ChannelAutoRegister }}
        # channel_expiry_days (auth): registered channels without joins or
        # messages for this long are unregistered (0 = never)
        expire-after: {{ .ChannelExpireAfter }}
    list-delay: 0s
    invite-expiration: 24h

# The stack's own classes have a "." in their names: network-role classes
# are named after the role's slug ([a-z0-9_-]), so they can never collide.
oper-classes:
    # The emergency /OPER {{ .OperName }} login (OPER_NAME / OPER_PASSWORD_HASH).
    "boson.server-admin":
        title: Server Admin
        capabilities:
            - "kill"
            - "ban"
            - "nofakelag"
            - "relaymsg"
            - "vhosts"
            - "sajoin"
            - "samode"
            - "snomasks"
            - "roleplay"
            - "rehash"
            - "accreg"
            - "chanreg"
            - "history"
            - "defcon"
            - "massmessage"
            - "metadata"
    # RoleServ (and other in-stack services) grant themselves this class
    # through the API (POST /v1/account_grants), to reply without fakelag.
    {{ q .ServiceClass }}:
        title: Network Service
        # (whoisline, not whois-line: Ergo 2.19's oper-classes key)
        whoisline: "is a network service"
        capabilities:
            - "nofakelag"
{{- if .RoleClasses }}
    # Network roles with "IRC operator" on (auth service, admin panel or
    # RoleServ), re-rendered by boson-ergo watch-settings when they change.
    # Members are opered up at login (account-bound, no /OPER), see
    # docs/roles.md.
{{- range .RoleClasses }}
    {{ q .Name }}:
        title: {{ q .Title }}
{{- if .WhoisLine }}
        whoisline: {{ q .WhoisLine }}
{{- end }}
{{- if .Capabilities }}
        capabilities:
{{- range .Capabilities }}
            - {{ q . }}
{{- end }}
{{- else }}
        capabilities: []
{{- end }}
{{- end }}
{{- end }}

opers:
    {{ q .OperName }}:
        class: "boson.server-admin"
        hidden: true
        whois-line: "is a Network Administrator"
        # bcrypt, from `ergo genpasswd` (scripts/setup.sh)
        password: {{ q .OperPasswordHash }}

{{- if .APIToken }}
# HTTP API for quicvoiced (founder checks, channel roles: POST /v1/ns/info,
# /v1/whois), boson-ergo watch-settings and RoleServ (POST /v1/rehash,
# /v1/account_grants: network roles). Plain HTTP on the compose network
# only; never published or routed by Traefik. Token: ERGO_API_TOKEN.
api:
    enabled: true
    listener: {{ q .APIListener }}
    bearer-tokens:
        - {{ q .APIToken }}
{{- end }}

logging:
    -
        method: stderr
        type: "* -userinput -useroutput"
        level: {{ q .LogLevel }}

debug:
    recover-from-errors: true

lock-file: "/ircd/ircd.lock"

datastore:
    path: "/ircd/ircd.db"
    autoupgrade: true
{{- if .PersistentHistory }}
    sqlite:
        enabled: true
        database-path: "/ircd/history.db"
        busy-timeout: 5s
        max-conns: 1
{{- end }}

languages:
    enabled: true
    default: en
    path: "/ircd-bin/languages"

limits:
    nicklen: 32
    identlen: 20
    realnamelen: 150
    channellen: 64
    awaylen: 390
    kicklen: 390
    topiclen: 390
    monitor-entries: 100
    whowas-entries: 100
    chan-list-modes: 100
    registration-messages: 1024
    multiline:
        max-bytes: 4096
        max-lines: 100

fakelag:
    enabled: true
    window: 1s
    burst-limit: 5
    messages-per-window: 2
    cooldown: 2s
    command-budgets:
        "CHATHISTORY": 16
        "MARKREAD": 16
        "MONITOR": 1
        "WHO": 4
        "WEBPUSH": 1

roleplay:
    enabled: false

history:
    enabled: true
    channel-length: 2048
    client-length: 256
    autoresize-window: 3d
    autoreplay-on-join: 0
    chathistory-maxmessages: 1000
    znc-maxmessages: 2048
    restrictions:
        expire-time: {{ q .HistoryExpire }}
        query-cutoff: 'none'
        grace-period: 1h
    persistent:
        enabled: {{ .PersistentHistory }}
        unregistered-channels: false
        registered-channels: "opt-out"
        direct-messages: "opt-out"
    retention:
        allow-individual-delete: false
        enable-account-indexing: false
    tagmsg-storage:
        default: false
        whitelist:
            - "+draft/react"
            - "+react"

allow-environment-overrides: false

metadata:
    enabled: true
    operator-only-modification: false
    max-subs: 100
    max-keys: 100
    client-throttle:
        enabled: true
        duration: 2m
        max-attempts: 10
