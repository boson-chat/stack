# Ergo configuration, rendered by `boson-ergo render` at every container start
# from environment variables (see .env.example). Edit this template, not the
# rendered /ircd/ircd.yaml. Everything not set here uses Ergo's defaults; the
# full reference is Ergo's default.yaml:
# https://github.com/ergochat/ergo/blob/stable/default.yaml

network:
    name: {{ q .NetworkName }}

server:
    name: {{ q .IRCHost }}

    listeners:
        # TLS IRC. The cert comes from Traefik via certsync; SIGHUP (sent by the
        # entrypoint when certsync updates it) reloads it without dropping anyone.
        ":6697":
            tls:
                cert: {{ q .TLSCert }}
                key: {{ q .TLSKey }}
            min-tls-version: 1.2
{{- if .Plaintext }}
        # Plaintext IRC for legacy clients (IRC_PLAINTEXT=true).
        ":6667":
{{- end }}
{{- if .WebSocket }}
        # WebSocket for web clients. Plain ws inside the compose network;
        # Traefik terminates TLS and serves it as wss://{{ .IRCHost }}/webirc.
        ":8097":
            websocket: true
{{- end }}

    sts:
        enabled: false

    websockets:
        # Pages allowed to open WebSocket connections (Origin header).
        allowed-origins:
{{- range .WebSocketOrigins }}
            - {{ q . }}
{{- end }}

    casemapping: "ascii"
    enforce-utf8: true
    lookup-hostnames: false
    check-ident: false
    coerce-ident: '~u'

    motd: "/ircd/ergo.motd"
    motd-formatting: true

    idle-timeouts:
        registration: 60s
        ping: 1m30s
        disconnect: 2m30s

    relaymsg:
        enabled: true
        separators: "/"
        available-to-chanops: true

    # Traefik (the WebSocket proxy) lives on the stack network; trust its
    # X-Forwarded-For and treat its connections as secure (it terminated TLS).
    proxy-allowed-from:
        - localhost
        - {{ q .StackSubnet }}
    secure-nets:
        - {{ q .StackSubnet }}

    max-sendq: 96k

    compatibility:
        force-trailing: true
        send-unprefixed-sasl: true
        allow-truncation: false

    ip-limits:
        count: true
        max-concurrent-connections: 16
        throttle: true
        window: 10m
        max-connections-per-window: 32
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        exempted:
            - "localhost"

    # Users see a hash like abcd1234.{{ .CloakNetname }} instead of their IP.
    # The cloak secret is generated on first start and kept in the datastore.
    ip-cloaking:
        enabled: true
        enabled-for-always-on: true
        netname: {{ q .CloakNetname }}
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        num-bits: 64

    oper-throttle: 10s

accounts:
    authentication-enabled: true

    # Accounts live in the boson auth service: sign up at https://{{ .AuthHost }}.
    # NickServ REGISTER is off; SASL / NickServ IDENTIFY go through auth-script.
    registration:
        enabled: false
        allow-before-connect: true
        throttling:
            enabled: true
            duration: 10m
            max-attempts: 30
        bcrypt-cost: 4
        verify-timeout: "32h"
        email-verification:
            enabled: false

    login-throttling:
        enabled: true
        duration: 1m
        max-attempts: 3

    skip-server-password: false
    login-via-pass-command: true
    # SCRAM needs Ergo to hold password hashes; the auth service holds them.
    advertise-scram: false

    require-sasl:
        enabled: false
        exempted:
            - "localhost"

    nick-reservation:
        enabled: true
        additional-nick-limit: 0
        method: strict
        allow-custom-enforcement: false
        guest-nickname-format: "Guest-*"
        force-guest-format: false
        force-nick-equals-account: true
        forbid-anonymous-nick-changes: false

    multiclient:
        enabled: true
        allowed-by-default: true
        # Users opt in with /msg NickServ SET always-on true.
        always-on: "opt-in"
        auto-away: "opt-in"
        always-on-expiration: 90d

    vhosts:
        enabled: true
        max-length: 64
        valid-regexp: '^[0-9A-Za-z.\-_/]+$'

    default-user-modes: +i

    # Passwords are checked by the boson auth service
    # (POST {{ .AuthVerifyURL }}).
    auth-script:
        enabled: true
        command: "/usr/local/bin/boson-ergo"
        args: ["auth-script"]
        autocreate: true
        timeout: 9s
        kill-timeout: 1s
        max-concurrency: 64

    # SASL OAUTHBEARER with a boson access token (aud "boson"), verified by
    # the same auth-script against the auth service's JWKS.
    oauth2:
        enabled: {{ .OAuthBearer }}
        autocreate: true
        auth-script: true
        # Unused (auth-script validates), but Ergo wants a parseable value.
        introspection-url: "http://auth:8080/unused"
        introspection-timeout: 10s

channels:
    default-modes: +ntC
    max-channels-per-client: 100
    operator-only-creation: false
    registration:
        enabled: true
        operator-only: false
        max-channels-per-account: 15
    list-delay: 0s
    invite-expiration: 24h

oper-classes:
    "chat-moderator":
        title: Chat Moderator
        capabilities:
            - "kill"
            - "ban"
            - "nofakelag"
            - "relaymsg"
            - "vhosts"
            - "sajoin"
            - "samode"
            - "snomasks"
            - "roleplay"
    "server-admin":
        title: Server Admin
        extends: "chat-moderator"
        capabilities:
            - "rehash"
            - "accreg"
            - "chanreg"
            - "history"
            - "defcon"
            - "massmessage"
            - "metadata"

opers:
    {{ q .OperName }}:
        class: "server-admin"
        hidden: true
        whois-line: "is a Network Administrator"
        # bcrypt, from `ergo genpasswd` (scripts/setup.sh)
        password: {{ q .OperPasswordHash }}

logging:
    -
        method: stderr
        type: "* -userinput -useroutput"
        level: {{ q .LogLevel }}

debug:
    recover-from-errors: true

lock-file: "/ircd/ircd.lock"

datastore:
    path: "/ircd/ircd.db"
    autoupgrade: true
{{- if .PersistentHistory }}
    sqlite:
        enabled: true
        database-path: "/ircd/history.db"
        busy-timeout: 5s
        max-conns: 1
{{- end }}

languages:
    enabled: true
    default: en
    path: "/ircd-bin/languages"

limits:
    nicklen: 32
    identlen: 20
    realnamelen: 150
    channellen: 64
    awaylen: 390
    kicklen: 390
    topiclen: 390
    monitor-entries: 100
    whowas-entries: 100
    chan-list-modes: 100
    registration-messages: 1024
    multiline:
        max-bytes: 4096
        max-lines: 100

fakelag:
    enabled: true
    window: 1s
    burst-limit: 5
    messages-per-window: 2
    cooldown: 2s
    command-budgets:
        "CHATHISTORY": 16
        "MARKREAD": 16
        "MONITOR": 1
        "WHO": 4
        "WEBPUSH": 1

roleplay:
    enabled: false

history:
    enabled: true
    channel-length: 2048
    client-length: 256
    autoresize-window: 3d
    autoreplay-on-join: 0
    chathistory-maxmessages: 1000
    znc-maxmessages: 2048
    restrictions:
        expire-time: {{ q .HistoryExpire }}
        query-cutoff: 'none'
        grace-period: 1h
    persistent:
        enabled: {{ .PersistentHistory }}
        unregistered-channels: false
        registered-channels: "opt-out"
        direct-messages: "opt-out"
    retention:
        allow-individual-delete: false
        enable-account-indexing: false
    tagmsg-storage:
        default: false
        whitelist:
            - "+draft/react"
            - "+react"

allow-environment-overrides: false

metadata:
    enabled: true
    operator-only-modification: false
    max-subs: 100
    max-keys: 100
    client-throttle:
        enabled: true
        duration: 2m
        max-attempts: 10
