-	ipStr := strings.Trim(ips[0], " ")
-	if ipStr != "" {
-		ip := net.ParseIP(ipStr)
-		if ip != nil {
-			remoteIP = ip
+	// boson: the client can send its own X-Forwarded-For; proxies append
+	// to it. Walk from the right, past our own proxies: the first address
+	// that isn't one of them is the client (upstream took the leftmost,
+	// which the client controls).
+	ips := strings.Split(strings.Join(req.Header.Values("x-forwarded-for"), ","), ",")
+	for i := len(ips) - 1; i >= 0; i-- {
+		ip := net.ParseIP(strings.TrimSpace(ips[i]))
+		if ip == nil {
+			break
+		}
+		remoteIP = ip
+		if !s.isTrustedProxy(ip) {
+			break
 		}
 	}
 
