# The federation e2e's checks with a browser: fed-e2e.py (all phases) runs
# here, driving the remote's admin panel with Playwright for Python. The
# image has the browsers; the Python package matches their version.
FROM mcr.microsoft.com/playwright/python:v1.65.1-noble
RUN pip install --no-cache-dir --break-system-packages playwright==1.65.1
