# Overrides on top of a `scripts/setup.sh --local` .env and test/acme/acme.env
# (see run.sh): Boson behind an outer reverse proxy that holds 80/443.
COMPOSE_PROFILES=auth
CERT_HOSTS=irc.boson.test,auth.boson.test,chat.boson.test,admin.boson.test,api.boson.test,voice.boson.test,files.boson.test
# Boson's Traefik on the outer proxy's Docker network gateway (as on a
# server whose proxy is a container), trusting the stack network's gateway:
# Docker hands Traefik every connection from there.
TRAEFIK_HTTP_PUBLISH=10.213.0.1:8081
TRAEFIK_HTTPS_PUBLISH=10.213.0.1:8444
TRAEFIK_PROXY_PROTOCOL_TRUSTED_IPS=10.203.53.1
