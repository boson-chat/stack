# Copy to .env (or run scripts/setup.sh, which fills in the secrets for you).
# Every variable the stack reads is listed here; commented ones are optional.

# ---- What runs ----------------------------------------------------------------
# Profiles: irc (Ergo), voice (quicvoiced), auth (auth service + Postgres),
# api (boson backend), metrics (VictoriaMetrics), admin (upcoming admin panel;
# not released yet), webroot (serve a host certbot's ACME webroot, see
# docs/deploy-boson-chat.md), wellknown (serve https://DOMAIN/.well-known/boson.json
# for client discovery; only if DOMAIN points at this server, see docs/voice.md).
# traefik and certsync always run.
COMPOSE_PROFILES=irc,voice,auth

# Extra compose files. Setting this turns off compose.override.yaml
# auto-loading, so list it too if you have one, e.g.
#   COMPOSE_FILE=compose.yaml:compose.auth-src.yaml:compose.override.yaml
#COMPOSE_FILE=compose.yaml:compose.auth-src.yaml
# Checkout to build the auth service from when using compose.auth-src.yaml.
#AUTH_SRC=../auth

# ---- Identity -----------------------------------------------------------------
NETWORK_NAME=Boson
DOMAIN=example.com
IRC_HOST=irc.example.com
VOICE_HOST=voice.example.com
# Accounts: sign-up/login API, JWKS for voice and IRC tokens.
AUTH_HOST=auth.example.com
# Upcoming admin panel (admin profile).
ADMIN_HOST=admin.example.com
ADMIN_EMAIL=admin@example.com

# ---- TLS (Traefik) ------------------------------------------------------------
# Let's Encrypt account email, or "local" for the local CA made by
# scripts/setup.sh --local (./local-certs; *.localhost dev installs).
TLS_ISSUER=admin@example.com
# ACME directory. Default: Let's Encrypt production. Staging (test certs, no
# rate limits): https://acme-staging-v02.api.letsencrypt.org/directory
# (Changing CA later: `docker compose down`, remove the traefik_acme volume.)
#ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Key type for ACME certificates: EC256, EC384, RSA2048, RSA4096, ...
#ACME_KEY_TYPE=EC256
# Hostnames Traefik keeps certificates for, comma-separated. Default:
# IRC_HOST,VOICE_HOST,AUTH_HOST. Leave a host out if something else manages
# its certificate (e.g. a legacy IRC server with certbot); add ADMIN_HOST
# when you run the admin profile, DOMAIN with the wellknown profile, and any
# host your own routers use.
#CERT_HOSTS=irc.example.com,voice.example.com,auth.example.com
#TRAEFIK_LOG_LEVEL=INFO

# Docker network for the stack. Fixed so the auth service and Ergo can trust
# X-Forwarded-For from Traefik. Pick another private /24 if it collides.
#STACK_SUBNET=10.203.53.0/24

# ---- IRC (Ergo) -------------------------------------------------------------------
OPER_NAME=admin
# bcrypt hash from `ergo genpasswd` (scripts/setup.sh makes one), in single
# quotes so compose doesn't expand the $ signs:
#   printf '%s\n' 'yourpassword' | docker run --rm -i --entrypoint /ircd-bin/ergo ghcr.io/ergochat/ergo:v2.19.1 genpasswd
OPER_PASSWORD_HASH=''
# Also serve plaintext IRC on 6667 (legacy clients). TLS on 6697 always.
IRC_PLAINTEXT=false
# Where 6667 is published (default: loopback only). 0.0.0.0:6667 = public.
#IRC_PLAINTEXT_PORT=127.0.0.1:6667
# WebSocket for web clients at wss://IRC_HOST/webirc (via Traefik).
#IRC_WEBSOCKET=true
# Page origins allowed to open it (comma-separated). Default: https://DOMAIN, https://*.DOMAIN
#IRC_WEBSOCKET_ORIGINS=
# SASL OAUTHBEARER with an auth-service access token (in addition to PLAIN).
#IRC_OAUTHBEARER=true
# Keep channel/DM history across restarts (SQLite in the ergo_db volume).
#IRC_PERSISTENT_HISTORY=true
# Who can create text channels comes from the auth service's channel_creation
# setting (admin panel), polled every SETTINGS_POLL_SECONDS. This is only the
# value used until auth answers the first time: registered | admins.
#IRC_CHANNEL_CREATION=registered
#SETTINGS_POLL_SECONDS=30
# Require every IRC client to log in (no guest connections).
#IRC_REQUIRE_SASL=false

# ---- Accounts (auth service + Postgres) ---------------------------------------------
# open | invite | closed
REGISTRATION=open
# Block login (web and IRC SASL) until the email is verified. Needs SMTP.
REQUIRE_EMAIL_VERIFICATION=true
# Base URL for links in emails (verify / reset). Default: https://AUTH_HOST
#AUTH_APP_URL=
#AUTH_COOKIE_SECURE=true
#AUTH_LOG_LEVEL=info

# ---- Secrets (scripts/setup.sh generates these) ---------------------------------
POSTGRES_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Losing it makes the stored
# signing keys unusable (the auth service refuses to start).
AUTH_KEY_ENCRYPTION_KEY=
# Shared by the auth service's internal API, Ergo's auth-script and
# quicvoiced (settings): openssl rand -hex 32
INTERNAL_API_TOKEN=
# Ergo's HTTP API (internal network only), used by quicvoiced for founder
# checks and IRC role locks on voice channels: openssl rand -hex 32. Empty = off.
ERGO_API_TOKEN=
# Optional: HS256 secret for legacy voice tokens (`quicvoiced token`).
VOICE_JWT_SECRET=

# ---- Voice (quicvoiced) -------------------------------------------------------------
# Voice channels, in display order: comma-separated id:Display Name. Ids are
# lowercase [a-z0-9-]{1,32}. Listed with live participants at
# https://VOICE_HOST/v1/rooms (voice token required); see docs/voice.md.
VOICE_ROOMS=general:General
# true: only those rooms (and ones created through the API) can be joined.
# false: any other name creates an ad-hoc room (the old behaviour).
#VOICE_ROOMS_STRICT=true
# Who can create voice channels comes from the auth service's
# voice_channel_creation setting (admins | founders | registered); this is
# the value used until auth answers. Needs quicvoice >= 1.5.0.
#VOICE_CHANNEL_CREATION=admins
# Dynamic voice channels per (non-admin) user / in total.
#VOICE_ROOMS_MAX_PER_USER=10
#VOICE_ROOMS_MAX=500
# Ergo API URL for quicvoiced (default http://ergo:8089; set when IRC runs elsewhere).
#VOICE_ERGO_API_URL=

# ---- Email (auth service: verification + password reset) ----------------------------
# Empty SMTP_HOST = emails are only logged (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls (implicit, 465) | none
SMTP_TLS=starttls

# ---- Metrics ----------------------------------------------------------------------
#METRICS_RETENTION=90d

# ---- webroot profile ----------------------------------------------------------------
# Serve WEBROOT_DIR at http://WEBROOT_HOST/.well-known/acme-challenge/ (for a
# certbot in webroot mode on the host). Keep WEBROOT_HOST out of CERT_HOSTS.
#WEBROOT_HOST=irc.example.com
#WEBROOT_DIR=/var/www/certbot

# ---- wellknown profile --------------------------------------------------------------
# Serves https://DOMAIN/.well-known/boson.json. Add DOMAIN to CERT_HOSTS.
# Sections published (irc, auth, voice). Default: whichever of those profiles
# are in COMPOSE_PROFILES. Set it when a part runs elsewhere, e.g. a legacy
# IRC server on IRC_HOST outside the stack: WELLKNOWN_SECTIONS=irc,auth,voice
#WELLKNOWN_SECTIONS=

# ---- Images (defaults are pinned in compose.yaml) -------------------------------------
#AUTH_IMAGE=harbor.floret.dev/boson/auth:1.0.0
#QUICVOICE_IMAGE=harbor.floret.dev/boson/quicvoice:1.5.0
#ADMIN_IMAGE=harbor.floret.dev/boson/admin:latest

# ---- Admin panel (admin profile) --------------------------------------------
# Add ADMIN_HOST to CERT_HOSTS so Traefik gets its certificate.
#ADMIN_IMAGE=harbor.floret.dev/boson/admin:1.0.0
# 32 random bytes, base64 (scripts/setup.sh generates it): openssl rand -base64 32
ADMIN_SESSION_KEY=
# Optional: link from the panel to Grafana.
GRAFANA_URL=
# Services control goes through the docker-proxy service, which runs as
# nobody:<docker group>. The host's docker group id: getent group docker | cut -d: -f3
DOCKER_GID=999
# Set empty to turn services control off (docker-proxy still starts with the
# admin profile; stop it with COMPOSE_PROFILES without admin).
#ADMIN_DOCKER_PROXY_URL=http://docker-proxy:2375
# Users' boson profiles come from the api profile; set empty without it.
#ADMIN_BOSON_API_URL=http://api:3000
