# Copy to .env (or run scripts/setup.sh, which fills in the secrets for you).
# Every variable the stack reads is listed here; commented ones are optional.
#
# .env holds secrets and deployment values (hosts, images, ports, tokens,
# URLs between services). Runtime settings live in config/boson.yaml
# (docs/config.md; the admin panel edits it): the variables marked
# "default; config/boson.yaml <key> wins" below are only used while that key
# isn't set in the file.

# ---- What runs ----------------------------------------------------------------
# Profiles: irc (Ergo), voice (quicvoiced), video (quicvideod, docs/video.md),
# auth (auth service + Postgres),
# api (boson backend), directory (a boson network directory, docs/directory.md),
# files (uploads, docs/files.md), minio (an S3 bucket for files),
# metrics (VictoriaMetrics), admin (admin panel), webroot (serve a host certbot's ACME webroot, see
# docs/deploy-boson-chat.md), wellknown (serve https://DOMAIN/.well-known/boson.json
# for client discovery; only if DOMAIN points at this server, see docs/voice.md).
# traefik and certsync always run.
COMPOSE_PROFILES=irc,voice,auth

# Extra compose files. Setting this turns off compose.override.yaml
# auto-loading, so list it too if you have one, e.g.
#   COMPOSE_FILE=compose.yaml:compose.auth-src.yaml:compose.override.yaml
#COMPOSE_FILE=compose.yaml:compose.auth-src.yaml
# Checkout to build the auth service from when using compose.auth-src.yaml.
#AUTH_SRC=../auth

# ---- Identity -----------------------------------------------------------------
# Default; config/boson.yaml network.name wins.
NETWORK_NAME=Boson
DOMAIN=example.com
IRC_HOST=irc.example.com
VOICE_HOST=voice.example.com
# Accounts: sign-up/login API, JWKS for voice and IRC tokens.
AUTH_HOST=auth.example.com
# Upcoming admin panel (admin profile).
ADMIN_HOST=admin.example.com
ADMIN_EMAIL=admin@example.com

# ---- TLS (Traefik) ------------------------------------------------------------
# Let's Encrypt account email, or "local" for the local CA made by
# scripts/setup.sh --local (./local-certs; *.localhost dev installs).
TLS_ISSUER=admin@example.com
# ACME directory. Default: Let's Encrypt production. Staging (test certs, no
# rate limits): https://acme-staging-v02.api.letsencrypt.org/directory
# (Changing CA later: `docker compose down`, remove the traefik_acme volume.)
#ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Key type for ACME certificates: EC256, EC384, RSA2048, RSA4096, ...
#ACME_KEY_TYPE=EC256
# Hostnames Traefik keeps certificates for, comma-separated. Default:
# IRC_HOST,VOICE_HOST,AUTH_HOST. Leave a host out if something else manages
# its certificate (e.g. a legacy IRC server with certbot); add ADMIN_HOST
# when you run the admin profile, DIRECTORY_HOST with the directory profile,
# FILES_HOST with the files profile, VIDEO_HOST with the video profile,
# DOMAIN with the wellknown profile, and any host your own routers use.
#CERT_HOSTS=irc.example.com,voice.example.com,auth.example.com
#TRAEFIK_LOG_LEVEL=INFO
# How long Traefik waits for a request (headers and body) on :443. Long, so
# uploads (files profile, FILES_UPLOAD_TIMEOUT 30m) aren't cut off; idle
# keep-alive connections close after TRAEFIK_IDLE_TIMEOUT.
#TRAEFIK_READ_TIMEOUT=35m
#TRAEFIK_IDLE_TIMEOUT=180s

# Docker network for the stack. Fixed so the auth service and Ergo can trust
# X-Forwarded-For from Traefik. Pick another private /24 if it collides.
#STACK_SUBNET=10.203.53.0/24

# ---- IRC (Ergo) -------------------------------------------------------------------
OPER_NAME=admin
# bcrypt hash from `ergo genpasswd` (scripts/setup.sh makes one), in single
# quotes so compose doesn't expand the $ signs:
#   printf '%s\n' 'yourpassword' | docker run --rm -i --entrypoint /ircd-bin/ergo ghcr.io/ergochat/ergo:v2.19.1 genpasswd
OPER_PASSWORD_HASH=''
# Also serve plaintext IRC on 6667 (legacy clients). TLS on 6697 always.
# Default; config/boson.yaml irc.plaintext wins (restart ergo after a change).
IRC_PLAINTEXT=false
# Where 6667 is published (default: loopback only). 0.0.0.0:6667 = public.
#IRC_PLAINTEXT_PORT=127.0.0.1:6667
# WebSocket for web clients at wss://IRC_HOST/webirc (via Traefik).
#IRC_WEBSOCKET=true
# Page origins allowed to open it (comma-separated). Default: https://DOMAIN, https://*.DOMAIN
#IRC_WEBSOCKET_ORIGINS=
# SASL OAUTHBEARER with an auth-service access token (in addition to PLAIN).
#IRC_OAUTHBEARER=true
# Keep channel/DM history across restarts (SQLite in the ergo_db volume).
#IRC_PERSISTENT_HISTORY=true
# Who can create text channels comes from the auth service's channel_creation
# setting (admin panel), polled every SETTINGS_POLL_SECONDS. This is only the
# value used until auth answers the first time: registered | admins.
#IRC_CHANNEL_CREATION=registered
#SETTINGS_POLL_SECONDS=30
# Guest access (IRC without an account) comes from the auth service's
# guest_access setting (admin panel → Network settings, auth >= 1.8).
# IRC_REQUIRE_SASL=true (no guests) is only used with an older auth, or
# until auth answers the first time.
#IRC_REQUIRE_SASL=false
# Addresses that may connect without logging in while guests are off
# (comma-separated IPs/CIDRs, e.g. a bouncer or gateway that can't do SASL).
# Default; config/boson.yaml irc.require_sasl_exempt wins.
#IRC_REQUIRE_SASL_EXEMPT=localhost
# Network roles on IRC (docs/roles.md): roles with "IRC operator" become Ergo
# oper classes; members are opered up at login, get the role's WHOIS line and
# vhost. Polled every ROLES_POLL_SECONDS (ETag, cheap). false = off.
#IRC_ROLES=true
# Default; config/boson.yaml irc.roles_poll_seconds wins.
#ROLES_POLL_SECONDS=10
# Ergo capabilities every IRC-operator role gets on top of its irc.*
# permissions (comma-separated, or none).
#IRC_ROLE_BASE_CAPABILITIES=nofakelag

# ---- Accounts (auth service + Postgres) ---------------------------------------------
# open | invite | closed. Default; config/boson.yaml auth.registration wins.
REGISTRATION=open
# Block login (web and IRC SASL) until the email is verified. Needs SMTP.
# Default; config/boson.yaml auth.require_email_verification wins.
REQUIRE_EMAIL_VERIFICATION=true
# Base URL for links in emails (verify / reset). Default: https://AUTH_HOST
#AUTH_APP_URL=
#AUTH_COOKIE_SECURE=true
#AUTH_LOG_LEVEL=info

# ---- Secrets (scripts/setup.sh generates these) ---------------------------------
POSTGRES_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Losing it makes the stored
# signing keys unusable (the auth service refuses to start).
AUTH_KEY_ENCRYPTION_KEY=
# Shared by the auth service's internal API, Ergo's auth-script and
# quicvoiced (settings): openssl rand -hex 32
INTERNAL_API_TOKEN=
# Ergo's HTTP API (internal network only), used by quicvoiced for founder
# checks and IRC role locks on voice channels, and by RoleServ and the role
# sync (role changes applied to connected users): openssl rand -hex 32.
# Empty = off (then roles apply at the next login, and RoleServ can't run).
ERGO_API_TOKEN=
# RoleServ acts on behalf of the users who message it through the auth
# service's acting endpoints; this token (auth: INTERNAL_ACTING_TOKEN) is
# the only one auth accepts there: openssl rand -hex 32.
ROLESERV_AUTH_TOKEN=
# Optional: HS256 secret for legacy voice tokens (`quicvoiced token`).
VOICE_JWT_SECRET=

# ---- Voice (quicvoiced) -------------------------------------------------------------
# Voice channels, in display order: comma-separated id:Display Name. Ids are
# lowercase [a-z0-9-]{1,32}. Listed with live participants at
# https://VOICE_HOST/v1/rooms (voice token required); see docs/voice.md.
# Default; config/boson.yaml voice.rooms wins.
VOICE_ROOMS=general:General
# true: only those rooms (and ones created through the API) can be joined.
# false: any other name creates an ad-hoc room (the old behaviour).
# Default; config/boson.yaml voice.rooms_strict wins.
#VOICE_ROOMS_STRICT=true
# Who can create voice channels comes from the auth service's
# voice_channel_creation setting (admins | founders | registered); this is
# the value used until auth answers. Needs quicvoice >= 1.5.0.
#VOICE_CHANNEL_CREATION=admins
# Dynamic voice channels per (non-admin) user / in total. Per user: default;
# config/boson.yaml voice.max_rooms_per_user wins.
#VOICE_ROOMS_MAX_PER_USER=10
#VOICE_ROOMS_MAX=500
# Ergo API URL for quicvoiced (default http://ergo:8089; set when IRC runs elsewhere).
#VOICE_ERGO_API_URL=

# ---- Video (quicvideod, video profile) -------------------------------------------
# Camera + screen share in voice channels; see docs/video.md. Setting
# VIDEO_HOST turns it on in quicvoiced (quicvoice >= 1.8.0): add the video
# profile (or point it at a video node) and VIDEO_HOST to CERT_HOSTS.
#VIDEO_HOST=video.example.com
# Shared by quicvoiced and quicvideod (scripts/setup.sh makes one).
VIDEO_CONTROL_TOKEN=
# Remote video node: quicvoiced reaches it at https://VIDEO_HOST/control.
#VIDEO_CONTROL_URL=https://video.example.com/control
# Override what clients are told (default quic://VIDEO_HOST:7710 and
# https://VIDEO_HOST:7710/wt), e.g. for another port.
#VIDEO_QUIC_URL=
#VIDEO_WEBTRANSPORT_URL=
# People per video room (default 20), and browser origins allowed to
# open WebTransport sessions (default *).
#VIDEO_MAX_PARTICIPANTS=20
#VIDEO_WEBTRANSPORT_ORIGINS=*
#QUICVIDEO_IMAGE=harbor.floret.dev/boson/quicvideo:1.7.2

# ---- Email (auth service: verification + password reset) ----------------------------
# Empty SMTP_HOST = emails are only logged (dev). SMTP_HOST, SMTP_PORT,
# SMTP_FROM, SMTP_TLS: defaults; config/boson.yaml auth.smtp.{host,port,from,tls}
# win. SMTP_USER and SMTP_PASSWORD are secrets and stay here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls (implicit, 465) | none
SMTP_TLS=starttls

# ---- api profile (boson backend, docs/api.md) --------------------------------------
# Add API_HOST to CERT_HOSTS. Database password (scripts/setup.sh generates it).
#API_HOST=api.example.com
API_DB_PASSWORD=
# The admin panel's calls to the api's internal port (http://api:3001: the
# Nick claims page, config status): openssl rand -hex 32
API_INTERNAL_TOKEN=
# Nick claims: register users' nicks on other IRC networks through a
# catch-all mailbox (docs/nick-claim.md). OFF by default.
# The variables below are DEFAULTS that moved to config/boson.yaml
# nick_claim.enabled / email_domain / rate_limit_per_hour /
# inbound.{host,port,user,tls}: the file wins (the admin panel's Nick claims
# page writes it), these are only used while a key isn't there.
#NICK_CLAIM_ENABLED=false
#NICK_CLAIM_EMAIL_DOMAIN=nick.example.com
#NICK_CLAIM_RATE_LIMIT_PER_HOUR=5
#POP3_HOST=mailserver.purelymail.com
#POP3_PORT=995
#POP3_USER=reg@nick.example.com
#POP3_TLS=true
# The inbound mailbox's password: a secret, so it stays here (never in the
# file). POP3_PASSWORD, its older name, still works.
#NICK_CLAIM_POP3_PASSWORD=

# ---- Metrics ----------------------------------------------------------------------
#METRICS_RETENTION=90d

# ---- webroot profile ----------------------------------------------------------------
# Serve WEBROOT_DIR at http://WEBROOT_HOST/.well-known/acme-challenge/ (for a
# certbot in webroot mode on the host). Keep WEBROOT_HOST out of CERT_HOSTS.
#WEBROOT_HOST=irc.example.com
#WEBROOT_DIR=/var/www/certbot

# ---- wellknown profile --------------------------------------------------------------
# Serves https://DOMAIN/.well-known/boson.json. Add DOMAIN to CERT_HOSTS.
# Sections published (irc, auth, voice, files). Default: whichever of those profiles
# are in COMPOSE_PROFILES. Set it when a part runs elsewhere, e.g. a legacy
# IRC server on IRC_HOST outside the stack: WELLKNOWN_SECTIONS=irc,auth,voice
#WELLKNOWN_SECTIONS=

# ---- Images (defaults are pinned in compose.yaml) -------------------------------------
#AUTH_IMAGE=harbor.floret.dev/boson/auth:1.12.0
#QUICVOICE_IMAGE=harbor.floret.dev/boson/quicvoice:1.7.0
#ADMIN_IMAGE=harbor.floret.dev/boson/admin:latest
#DIRECTORY_IMAGE=harbor.floret.dev/boson/directory:1.7.0
#FILES_IMAGE=harbor.floret.dev/boson/files:1.0.1

# ---- Admin panel (admin profile) --------------------------------------------
# Add ADMIN_HOST to CERT_HOSTS so Traefik gets its certificate.
# The ADMIN_* URLs below (DIRECTORY_API_URL, METRICS_URL, DOCKER_PROXY_URL,
# BOSON_API_URL, IRC_CHECK, the health and status targets) are deployment
# settings: how the panel reaches the rest of the stack. They stay in .env;
# after changing one run `docker compose up -d admin`. What the panel lets
# you change at runtime is in config/boson.yaml.
# Live metrics: a Prometheus-compatible query API; empty = off.
#ADMIN_METRICS_URL=http://victoriametrics:8428
# IRC health probe (Ergo); empty without the irc profile.
#ADMIN_IRC_CHECK=ircs://ergo:6697
#ADMIN_IMAGE=harbor.floret.dev/boson/admin:1.17.0
# 32 random bytes, base64 (scripts/setup.sh generates it): openssl rand -base64 32
ADMIN_SESSION_KEY=
# Optional: link from the panel to Grafana.
GRAFANA_URL=
# Services control goes through the docker-proxy service, which runs as
# nobody:<docker group>. The host's docker group id: getent group docker | cut -d: -f3
DOCKER_GID=999
# Set empty to turn services control off (docker-proxy still starts with the
# admin profile; stop it with COMPOSE_PROFILES without admin).
#ADMIN_DOCKER_PROXY_URL=http://docker-proxy:2375
# Users' boson profiles come from the api profile; set empty without it.
#ADMIN_BOSON_API_URL=http://api:3000
# The api's internal port (Nick claims page, test connection); empty without
# the api profile. Uses API_INTERNAL_TOKEN.
#ADMIN_BOSON_API_INTERNAL_URL=http://api:3001
# The boson directory the Directory page lists this network in (network key +
# DNS TXT proof). Empty = the page is off.
#ADMIN_DIRECTORY_API_URL=https://directory.boson.chat
# Register the network from the Directory page; false = only report the
# listing. Default; config/boson.yaml admin.directory_registration wins (the
# hostname it lists: admin.directory_hostname, default IRC_HOST).
#ADMIN_DIRECTORY_REGISTRATION=true
# Certificates the Overview watches: comma-separated host:port, optionally
# @dial-host:dial-port. Default: every CERT_HOSTS hostname on 443 via
# traefik, IRC_HOST on 6697. config/boson.yaml admin.tls_check_hosts wins.
#ADMIN_TLS_CHECK_HOSTS=irc.example.com:6697,voice.example.com:443@traefik:443
# The Overview shows the services that have a container (via docker-proxy)
# with built-in checks. These name=url lists add to or replace them by name
# (with ADMIN_DOCKER_PROXY_URL= they are the whole list):
#ADMIN_HEALTH_TARGETS=grafana=http://grafana:3000/api/health
#ADMIN_VERSION_TARGETS=
#ADMIN_PUBLIC_PROBES=
# Where the panel asks each service whether it applied config/boson.yaml
# (compose service = internal /internal/config/status URL). Deployment value.
#ADMIN_CONFIG_STATUS_TARGETS=auth=http://auth:8081/internal/config/status,quicvoiced=http://quicvoiced:8080/internal/config/status,directory=http://directory:8081/internal/config/status,ergo=http://ergo:8098/internal/config/status,api=http://api:3001/internal/config/status,files=http://files:3001/internal/config/status
# The stack's own directory (directory profile): the panel's "Include the
# boson main directory" switch, peers and users' listings. Needs
# DIRECTORY_INTERNAL_TOKEN. scripts/setup.sh sets it with the profile.
#ADMIN_DIRECTORY_LOCAL_URL=http://directory:8080
# The files service's internal port (Uploads page status, moderation,
# users' usage); empty without the files profile. Uses FILES_INTERNAL_TOKEN.
#ADMIN_FILES_INTERNAL_URL=http://files:3001

# ---- directory profile (docs/directory.md) ----------------------------------------
# A boson network directory (github.com/boson-chat/directory): website + /v1
# API at DIRECTORY_HOST (add it to CERT_HOSTS). Needs the auth profile
# (Postgres, sign-in).
#DIRECTORY_HOST=directory.example.com
# The directory web UI signs people in against auth from the browser, so
# auth must allow its origin (setup.sh adds it with the directory profile):
# Default; config/boson.yaml auth.cors_allowed_origins wins.
#AUTH_CORS_ALLOWED_ORIGINS=https://directory.example.com
# The next five are DEFAULTS only: config/boson.yaml directory.include_main /
# main_peer_url / peers / name / contact win (the admin panel's Directory
# page writes them there; without BOSON_CONFIG, directory >= 1.4.0 stores
# them in its database). They apply without a restart.
# Your directory also shows everything from directory.boson.chat (each
# listing re-checked against its own DNS before it appears); false = an
# independent directory.
DIRECTORY_INCLUDE_MAIN=true
#DIRECTORY_MAIN_PEER=https://directory.boson.chat
# More directories to import, comma-separated base URLs; each is added once
# on start (manage peers in the admin panel afterwards).
#DIRECTORY_PEERS=https://dir.example.net
# Shown in /.well-known/boson-directory.json. Default: "<NETWORK_NAME> directory", ADMIN_EMAIL.
#DIRECTORY_NAME=
#DIRECTORY_CONTACT=
# Database (created on Postgres' first start; existing installs: docs/directory.md).
DIRECTORY_DB_PASSWORD=
#DIRECTORY_DB_USER=directory
#DIRECTORY_DB_NAME=directory
# Operator API token (X-Internal-Token), shared with the admin panel: openssl rand -hex 32
DIRECTORY_INTERNAL_TOKEN=
# true = https://API_HOST/servers* goes to the directory instead of the api
# profile (the old directory paths, for older clients). The cutover switch;
# recreate traefik after changing it. docs/directory.md.
#DIRECTORY_SERVES_LEGACY=false
#DIRECTORY_LOG_LEVEL=info

# ---- files profile (uploads, docs/files.md) -----------------------------------------
# Public API and downloads at FILES_HOST: its own hostname (add it to
# CERT_HOSTS and DNS), never the app's or auth's. Needs the auth profile.
#FILES_HOST=files.example.com
# Uploads are off until config/boson.yaml files.enabled: true (the admin
# panel's Uploads page). This is only the default while that key is unset;
# auth reads it too (files_url in GET /v1/config).
#FILES_ENABLED=false
# Database (created on Postgres' first start; existing installs: docs/files.md).
FILES_DB_PASSWORD=
#FILES_DB_USER=files
#FILES_DB_NAME=files
# The admin panel's calls to the files internal port (X-Internal-Token):
# openssl rand -hex 32
FILES_INTERNAL_TOKEN=
# Signs guest upload tokens (16+ characters; empty = guests off): openssl rand -hex 32
FILES_GUEST_SECRET=
# Guest tokens one IP may get per hour.
#FILES_GUEST_TOKENS_PER_HOUR=10
# How long one upload may take (keep TRAEFIK_READ_TIMEOUT longer).
#FILES_UPLOAD_TIMEOUT=30m
# storage.driver: s3 (config/boson.yaml files.storage). Secrets, so only here.
# With the minio profile: the bucket-only user minio-init creates.
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
#FILES_LOG_LEVEL=info

# ---- minio profile (S3 storage for files on this host) ------------------------------
# Internal only (API :9000 is not published or routed; the console is off).
# Root credentials: minio-init uses them to create the bucket and the files
# user above. scripts/setup.sh generates them.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
#FILES_S3_BUCKET=boson-files
# Sized for a 2 GB VPS.
#MINIO_MEM_LIMIT=320m
# The web console (port 9001, never published): off. on = reachable through
# an SSH tunnel only (docs/files.md).
#MINIO_BROWSER=off
