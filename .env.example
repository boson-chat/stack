# Copy to .env (or run scripts/setup.sh, which fills in the secrets for you).

# ---- Identity ---------------------------------------------------------------
NETWORK_NAME=Boson
DOMAIN=example.com
IRC_HOST=irc.example.com
VOICE_HOST=voice.example.com
# Internal name only (never resolved publicly), must differ from IRC_HOST.
SERVICES_HOST=services.example.com
ADMIN_EMAIL=admin@example.com

# Let's Encrypt contact email, or "internal" for a self-signed local CA.
TLS_ISSUER=admin@example.com

# ---- IRC operator -----------------------------------------------------------
OPER_NAME=admin
# argon2 hash; generate with scripts/setup.sh or:
#   docker compose run --rm --no-deps --entrypoint ./unrealircd unrealircd mkpasswd argon2 'yourpassword'
OPER_PASSWORD_HASH=

# Also listen for plaintext IRC on 6667 (legacy clients). TLS on 6697 always.
IRC_PLAINTEXT=false

# ---- Secrets (scripts/setup.sh generates these) ------------------------------
SERVICES_LINK_PASSWORD=
CLOAK_KEY1=
CLOAK_KEY2=
CLOAK_KEY3=
VOICE_JWT_SECRET=

# ---- Email for NickServ registration (optional; empty = no email) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Images (pin versions for production) -----------------------------------
QUICVOICE_IMAGE=ghcr.io/boson-chat/quicvoice:1.1.0
