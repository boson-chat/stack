.env
.env.*
!.env.example
# Local dev CA + certificate from scripts/setup.sh --local
/local-certs/
# Install-specific config
/compose.override.yaml
/traefik/dynamic/*
!/traefik/dynamic/README.md
!/traefik/dynamic/stack.yml
!/traefik/dynamic/directory.yml
# The stack config file is install-specific (scripts/setup.sh creates it)
/config/*
!/config/boson.example.yaml
# Branding images (admin panel / by hand, docs/branding.md): the directory
# ships empty
!/config/branding/
/config/branding/*
!/config/branding/.gitkeep

# The web smoke (test/web)
node_modules/
test-results/

# The setup wizard e2e (test/setup)
test/setup/shots/
