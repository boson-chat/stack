# Caddy obtains and renews certificates for every hostname in the stack.
# IRC and voice don't speak HTTP; their names are listed here only so Caddy
# keeps certs for them, which certsync hands to unrealircd and quicvoiced.
#
# CERT_HOSTS: comma-separated hostnames Caddy should hold certificates for
#             (default: IRC_HOST, VOICE_HOST).
# TLS_ISSUER: an email address for Let's Encrypt, or "internal" for a local
#             self-signed CA (development).
{
	admin off
}

# Install-specific extra sites (e.g. an ACME webroot for a certbot that
# still manages some other certificate on this host). Mounted from
# caddy/sites/; empty by default.
import /etc/caddy/sites/*.caddy

{$CERT_HOSTS} {
	tls {$TLS_ISSUER}
	respond "{$NETWORK_NAME}" 200
}
